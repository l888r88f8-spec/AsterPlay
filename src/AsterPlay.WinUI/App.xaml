<Application
    x:Class="AsterPlay.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Color x:Key="AsterBackgroundColor">#080A0F</Color>
        <SolidColorBrush x:Key="AsterBackgroundBrush" Color="{StaticResource AsterBackgroundColor}"/>
        <SolidColorBrush x:Key="AsterPrimaryTextBrush" Color="#F7F8FB"/>
        <SolidColorBrush x:Key="AsterSecondaryTextBrush" Color="#A5ADBA"/>
        <Style x:Key="DockButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C7CED8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
    </Application.Resources>
</Application>
