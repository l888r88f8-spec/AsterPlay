<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AsterPlay.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="AsterBackgroundColor">#080A0F</Color>
            <SolidColorBrush x:Key="AsterBackgroundBrush" Color="{StaticResource AsterBackgroundColor}"/>
            <SolidColorBrush x:Key="AsterPrimaryTextBrush" Color="#F7F8FB"/>
            <SolidColorBrush x:Key="AsterSecondaryTextBrush" Color="#A5ADBA"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
