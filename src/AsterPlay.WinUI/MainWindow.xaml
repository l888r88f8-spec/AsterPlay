<Window
    x:Class="AsterPlay.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lg="using:LiquidGlassWinUI"
    Title="AsterPlay">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          Background="{ThemeResource AsterPageBackgroundBrush}"
          Loaded="RootGrid_Loaded">
        <Grid.Resources>
        <Style x:Key="DockButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF101217"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Opacity="0"
              Background="{ThemeResource AsterTitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TitleBrandPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Margin="18,0,0,0">
                <Border Width="27"
                        Height="27"
                        CornerRadius="9"
                        Background="{ThemeResource AsterCardBackgroundBrush}">
                    <TextBlock Text="A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="AsterPlay"
                           Foreground="{ThemeResource AsterPrimaryTextBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="PageTitleBlock"
                       Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource AsterSecondaryTextBrush}"
                       FontSize="13"/>
        </Grid>

        <Grid x:Name="ContentLayer"
              Grid.Row="1"
              Opacity="0">
            <ContentControl x:Name="PageHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>

            <Border x:Name="NavigationDock"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,14"
                    Padding="6"
                    CornerRadius="34"
                    BorderBrush="#78FFFFFF"
                    BorderThickness="1"
                    Visibility="Visible">
                <Border.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                     Color="#34FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                     Color="#52FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                     Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                     Color="Transparent"/>
                </Border.Resources>
                <Border.Background>
                    <lg:LiquidGlassBrush BlurAmount="3.4"
                                         BloomAmount="0.10"
                                         RefThickness="38"
                                         RefFactor="2.24"
                                         RefDispersion="3.8"
                                         DispersionRange="0.30"
                                         RefFresnelFactor="22"
                                         GlareFactor="60"
                                         TintA="0.44"
                                         TintR="239"
                                         TintG="239"
                                         TintB="244"
                                         ShapeRadius="0.99"
                                         ShapeRoundness="4.0"/>
                </Border.Background>
                <StackPanel Orientation="Horizontal"
                            Spacing="2">
                    <Button x:Name="HomeButton"
                            Style="{StaticResource DockButtonStyle}"
                            Click="Home_Click">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE80F;"
                                      FontSize="19"
                                      Foreground="{Binding Foreground, ElementName=HomeButton}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="首页"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, ElementName=HomeButton}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LibraryButton"
                            Style="{StaticResource DockButtonStyle}"
                            Click="Library_Click">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE8F1;"
                                      FontSize="19"
                                      Foreground="{Binding Foreground, ElementName=LibraryButton}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="媒体库"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, ElementName=LibraryButton}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ServersButton"
                            Style="{StaticResource DockButtonStyle}"
                            Click="Servers_Click">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE7F8;"
                                      FontSize="19"
                                      Foreground="{Binding Foreground, ElementName=ServersButton}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="服务器"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, ElementName=ServersButton}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource DockButtonStyle}"
                            Click="Settings_Click">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE713;"
                                      FontSize="19"
                                      Foreground="{Binding Foreground, ElementName=SettingsButton}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="设置"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, ElementName=SettingsButton}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SplashLayer"
              Grid.Row="0"
              Grid.RowSpan="2"
              Background="Transparent"
              IsHitTestVisible="True"
              Canvas.ZIndex="2000">
            <Rectangle x:Name="SplashBackdropShade"
                       Fill="{ThemeResource AsterPageBackgroundBrush}"/>

            <!-- The startup mark is deliberately self-contained: initially only the
                 circular AsterPlay symbol is visible. During reveal, this glass
                 surface expands into the application while its sharp mark fades. -->
            <Grid x:Name="SplashIconHost"
                  Width="104"
                  Height="104"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="SplashCircleScale"
                                    ScaleX="1"
                                    ScaleY="1"/>
                </Grid.RenderTransform>

                <Border x:Name="SplashCircle"
                        Width="104"
                        Height="104"
                        CornerRadius="52"
                        BorderBrush="#78FFFFFF"
                        BorderThickness="1">
                    <Border.Background>
                        <lg:LiquidGlassBrush BlurAmount="2.7"
                                             BloomAmount="0.24"
                                             RefThickness="42"
                                             RefFactor="2.55"
                                             RefDispersion="5.4"
                                             DispersionRange="0.45"
                                             RefFresnelFactor="26"
                                             GlareFactor="72"
                                             TintA="0.22"
                                             TintR="78"
                                             TintG="140"
                                             TintB="245"
                                             ShapeRadius="0.99"
                                             ShapeRoundness="4.0"/>
                    </Border.Background>
                </Border>

                <Grid x:Name="SplashMark"
                      Width="104"
                      Height="104">
                    <Ellipse Margin="10"
                             Stroke="#38FFFFFF"
                             StrokeThickness="1"/>
                    <Path Data="M 29,68 L 51.5,31 L 75,68 M 38,55 L 66,55"
                          Stroke="White"
                          StrokeThickness="7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>
                    <Ellipse Width="9"
                             Height="9"
                             Fill="#EFFFFFFF"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,20,20,0"/>
                </Grid>

                <Border x:Name="SplashBlurVeil"
                        Width="104"
                        Height="104"
                        CornerRadius="52"
                        Opacity="0">
                    <Border.Background>
                        <AcrylicBrush TintColor="#8FA7D8"
                                      TintOpacity="0.12"
                                      TintLuminosityOpacity="0.58"
                                      FallbackColor="#36506F9A"/>
                    </Border.Background>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</Window>
