<Window
    x:Class="AsterPlay.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lg="using:LiquidGlassWinUI"
    Title="AsterPlay">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource AsterPageBackgroundBrush}"
          Loaded="RootGrid_Loaded">
        <Grid.Resources>
        <Style x:Key="DockButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF101217"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Opacity="1"
              Background="{ThemeResource AsterTitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TitleBrandPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Margin="18,0,0,0">
                <Border Width="27"
                        Height="27"
                        CornerRadius="9"
                        Background="{ThemeResource AsterCardBackgroundBrush}">
                    <TextBlock Text="A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="AsterPlay"
                           Foreground="{ThemeResource AsterPrimaryTextBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="PageTitleBlock"
                       Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource AsterSecondaryTextBrush}"
                       FontSize="13"/>
        </Grid>

        <Grid x:Name="ContentLayer"
              Grid.Row="1"
              Opacity="1">
            <ContentControl x:Name="PageHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>

            <Border x:Name="NavigationDock"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,14"
                    Padding="6"
                    CornerRadius="34"
                    BorderBrush="#78FFFFFF"
                    BorderThickness="1"
                    Visibility="Visible">
                <Border.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                     Color="#34FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                     Color="#52FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                     Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                     Color="Transparent"/>
                </Border.Resources>
                <Border.Background>
                    <lg:LiquidGlassBrush BlurAmount="3.4"
                                         BloomAmount="0.10"
                                         RefThickness="38"
                                         RefFactor="2.24"
                                         RefDispersion="3.8"
                                         DispersionRange="0.30"
                                         RefFresnelFactor="22"
                                         GlareFactor="60"
                                         TintA="0.44"
                                         TintR="239"
                                         TintG="239"
                                         TintB="244"
                                         ShapeRadius="0.99"
                                         ShapeRoundness="4.0"/>
                </Border.Background>
                <StackPanel Orientation="Horizontal"
                            Spacing="2">
                    <Button x:Name="HomeButton"
                            Style="{StaticResource DockButtonStyle}"
                            Click="Home_Click">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE80F;"
                                      FontSize="19"
                                      Foreground="{Binding Foreground, ElementName=HomeButton}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="首页"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, ElementName=HomeButton}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LibraryButton"
                            Style="{StaticResource DockButtonStyle}"
                            Click="Library_Click">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE8F1;"
                                      FontSize="19"
                                      Foreground="{Binding Foreground, ElementName=LibraryButton}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="媒体库"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, ElementName=LibraryButton}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ServersButton"
                            Style="{StaticResource DockButtonStyle}"
                            Click="Servers_Click">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE7F8;"
                                      FontSize="19"
                                      Foreground="{Binding Foreground, ElementName=ServersButton}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="服务器"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, ElementName=ServersButton}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource DockButtonStyle}"
                            Click="Settings_Click">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE713;"
                                      FontSize="19"
                                      Foreground="{Binding Foreground, ElementName=SettingsButton}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="设置"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, ElementName=SettingsButton}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>


        <Grid x:Name="StartupCoverLayer"
              Grid.RowSpan="2"
              Panel.ZIndex="10000"
              Background="{ThemeResource AsterPageBackgroundBrush}"
              Visibility="Visible">
            <Image Source="ms-appx:///Assets/AsterPlay.AppIcon.png"
                   Width="144"
                   Height="144"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</Window>
