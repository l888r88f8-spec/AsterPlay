<Window
    x:Class="AsterPlay.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AsterPlay">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          Background="{ThemeResource AsterPageBackgroundBrush}"
          Loaded="RootGrid_Loaded">
        <Grid.Resources>
        <Style x:Key="DockButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{ThemeResource AsterSecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Opacity="0"
              Background="{ThemeResource AsterTitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TitleBrandPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Margin="18,0,0,0">
                <Border Width="27"
                        Height="27"
                        CornerRadius="9"
                        Background="{ThemeResource AsterCardBackgroundBrush}">
                    <TextBlock Text="A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="AsterPlay"
                           Foreground="{ThemeResource AsterPrimaryTextBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="PageTitleBlock"
                       Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource AsterSecondaryTextBrush}"
                       FontSize="13"/>
        </Grid>

        <Grid x:Name="ContentLayer"
              Grid.Row="1"
              Opacity="0">
            <ContentControl x:Name="PageHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>

            <Border x:Name="NavigationDock"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,22"
                    Padding="8"
                    CornerRadius="38"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    Visibility="Visible">
                <Border.Background>
                    <AcrylicBrush TintColor="{ThemeResource AsterHeroFadeEndColor}"
                                  TintOpacity="0.20"
                                  TintLuminosityOpacity="0.72"
                                  FallbackColor="{ThemeResource AsterCardBackgroundBrush}"/>
                </Border.Background>
                <StackPanel Orientation="Horizontal"
                            Spacing="2">
                    <Button x:Name="HomeButton"
                            Style="{StaticResource DockButtonStyle}"
                            Click="Home_Click">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE80F;"
                                      FontSize="20"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="首页"
                                       FontSize="11"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LibraryButton"
                            Style="{StaticResource DockButtonStyle}"
                            Click="Library_Click">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE8F1;"
                                      FontSize="20"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="媒体库"
                                       FontSize="11"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ServersButton"
                            Style="{StaticResource DockButtonStyle}"
                            Click="Servers_Click">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE7F8;"
                                      FontSize="20"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="服务器"
                                       FontSize="11"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource DockButtonStyle}"
                            Click="Settings_Click">
                        <StackPanel Spacing="2">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE713;"
                                      FontSize="20"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="设置"
                                       FontSize="11"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SplashLayer"
              Grid.Row="0"
              Grid.RowSpan="2"
              Background="{ThemeResource AsterPageBackgroundBrush}"
              IsHitTestVisible="True"
              Canvas.ZIndex="2000">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <Border x:Name="SplashCircle"
                        Width="96"
                        Height="96"
                        CornerRadius="48"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#4C8FEA"
                                          Offset="0"/>
                            <GradientStop Color="#6E5CE7"
                                          Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="SplashCircleScale"
                                        ScaleX="1"
                                        ScaleY="1"/>
                    </Border.RenderTransform>
                    <TextBlock Text="A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="42"
                               FontWeight="SemiBold"/>
                </Border>

                <TextBlock x:Name="SplashWordmark"
                           Text="AsterPlay"
                           Foreground="{ThemeResource AsterPrimaryTextBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
