<Window
    x:Class="AsterPlay.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lg="using:LiquidGlassWinUI"
    Title="AsterPlay">
    <Grid Background="#080A0F">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Background="#121722">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Margin="18,0,0,0">
                <Border Width="26"
                        Height="26"
                        CornerRadius="9"
                        Background="#397FD4">
                    <TextBlock Text="A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="AsterPlay"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="720"
                        Spacing="14">
                <TextBlock Text="AsterPlay · WinUI 3"
                           HorizontalAlignment="Center"
                           Foreground="White"
                           FontSize="42"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="CoreStatusText"
                           Text="正在读取共享核心状态…"
                           HorizontalAlignment="Center"
                           Foreground="#A5ADBA"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="ServerStatusText"
                           Text=""
                           HorizontalAlignment="Center"
                           Foreground="#A5ADBA"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,24"
                    Padding="8"
                    CornerRadius="28">
                <Border.Background>
                    <lg:LiquidGlassBrush BlurAmount="1.5"
                                         BloomAmount="0.18"
                                         RefThickness="28"
                                         RefFactor="1.8"
                                         RefDispersion="3.5"
                                         GlareFactor="58"
                                         TintA="0.08"
                                         TintR="190"
                                         TintG="220"
                                         TintB="255"
                                         ShapeRadius="0.92"
                                         ShapeRoundness="3.8"/>
                </Border.Background>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="首页" Click="Home_Click"/>
                    <Button Content="媒体库" Click="Library_Click"/>
                    <Button Content="服务器" Click="Servers_Click"/>
                    <Button Content="设置" Click="Settings_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
