<Window
    x:Class="AsterPlay.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lg="using:LiquidGlassWinUI"
    Title="AsterPlay">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.18,0.08" GradientOrigin="0.18,0.08" RadiusX="0.92" RadiusY="0.92">
                <GradientStop Color="#273A72C7" Offset="0"/>
                <GradientStop Color="#11131D2C" Offset="0.46"/>
                <GradientStop Color="#080A0F" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Margin="18,0,0,0">
                <Border Width="26" Height="26" CornerRadius="9">
                    <Border.Background>
                        <lg:LiquidGlassBrush BlurAmount="1.2"
                                             BloomAmount="0.35"
                                             TintA="0.18"
                                             TintR="95"
                                             TintG="170"
                                             TintB="255"
                                             RefThickness="18"
                                             RefFactor="1.7"
                                             RefDispersion="4"
                                             GlareFactor="72"
                                             ShapeRadius="0.92"
                                             ShapeRoundness="3.8"/>
                    </Border.Background>
                    <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="AsterPlay" Foreground="{StaticResource AsterPrimaryTextBrush}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid Margin="48,36,48,122">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" MaxWidth="720">
                    <TextBlock Text="AsterPlay" Foreground="{StaticResource AsterPrimaryTextBrush}"
                               FontSize="54" FontWeight="SemiBold"/>
                    <TextBlock Text="WinUI 3 migration shell" Margin="0,8,0,0"
                               Foreground="#7DBBFF" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="稳定的 Emby / 播放核心继续复用，界面层迁移到 Windows App SDK 与原生 Composition。"
                               Margin="0,18,0,0" MaxWidth="650" TextWrapping="Wrap"
                               Foreground="{StaticResource AsterSecondaryTextBrush}" FontSize="18"/>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
                    <Border.Background>
                        <lg:LiquidGlassBrush BlurAmount="1.7"
                                             BloomAmount="0.22"
                                             Brightness="0.02"
                                             Contrast="1.05"
                                             Saturation="1.08"
                                             RefThickness="34"
                                             RefFactor="2.1"
                                             RefDispersion="5"
                                             DispersionRange="0.48"
                                             RefFresnelFactor="25"
                                             GlareAngle="-135"
                                             GlareFactor="68"
                                             GlareRange="34"
                                             TintA="0.10"
                                             TintR="185"
                                             TintG="215"
                                             TintB="255"
                                             ShapeRadius="0.82"
                                             ShapeRoundness="3.8"/>
                    </Border.Background>
                    <StackPanel Spacing="14">
                        <TextBlock Text="迁移状态" Foreground="{StaticResource AsterPrimaryTextBrush}"
                                   FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CoreStatusText" Text="正在读取共享核心状态…"
                                   Foreground="{StaticResource AsterSecondaryTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ServerStatusText" Text=""
                                   Foreground="{StaticResource AsterSecondaryTextBrush}" TextWrapping="Wrap"/>
                        <Border Height="1" Background="#24FFFFFF" Margin="0,4"/>
                        <TextBlock Text="下一阶段" Foreground="#E9EDF4" FontWeight="SemiBold"/>
                        <TextBlock Text="将登录、首页、媒体库、服务器和设置逐页迁移，再单独接入 mpv D3D11 composition + SwapChainPanel。"
                                   Foreground="{StaticResource AsterSecondaryTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,24" Padding="8" CornerRadius="30">
                <Border.Background>
                    <lg:LiquidGlassBrush BlurAmount="1.9"
                                         BloomAmount="0.16"
                                         Brightness="0.03"
                                         Contrast="1.08"
                                         Saturation="1.12"
                                         RefThickness="42"
                                         RefFactor="2.45"
                                         RefDispersion="5.5"
                                         DispersionRange="0.42"
                                         RefFresnelFactor="28"
                                         GlareAngle="-145"
                                         GlareFactor="72"
                                         GlareHardness="14"
                                         GlareRange="38"
                                         TintA="0.09"
                                         TintR="185"
                                         TintG="215"
                                         TintB="255"
                                         ShapeRadius="0.96"
                                         ShapeRoundness="3.7"/>
                </Border.Background>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Style="{StaticResource DockButtonStyle}" Content="⌂  首页" Click="Home_Click"/>
                    <Button Style="{StaticResource DockButtonStyle}" Content="▦  媒体库" Click="Library_Click"/>
                    <Button Style="{StaticResource DockButtonStyle}" Content="◫  服务器" Click="Servers_Click"/>
                    <Button Style="{StaticResource DockButtonStyle}" Content="⚙  设置" Click="Settings_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
