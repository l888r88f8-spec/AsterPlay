<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>AsterPlay.WinUI</RootNamespace>
    <AssemblyName>AsterPlay</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AsterPlay.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Keep normal Debug/F5 builds framework-dependent so unchanged outputs
         can be reused quickly. Release publish stays fully self-contained. -->
    <WindowsAppSDKSelfContained Condition="'$(Configuration)' == 'Debug'">false</WindowsAppSDKSelfContained>
    <WindowsAppSDKSelfContained Condition="'$(Configuration)' != 'Debug'">true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AsterPlay.AppIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\AsterPlay.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsterPlay.Core\AsterPlay.Core.csproj" />
    <ProjectReference Include="..\LiquidGlassWinUI\LiquidGlassWinUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <AsterPlayLiquidGlassCompatRuntime>$(MSBuildThisFileDirectory)..\..\Native\LiquidGlassCompat\Prebuilt\win-x64\CustomEffectRuntimeNative.dll</AsterPlayLiquidGlassCompatRuntime>
  </PropertyGroup>

  <!-- LiquidGlassWinUI 1.0.3 ships a native runtime built for Windows App SDK
       2.2.0. Always overwrite it with AsterPlay's SDK 2.5.1 compatibility
       runtime for normal Build/F5 as well as direct dotnet publish. -->
  <Target Name="CopyAsterPlayLiquidGlassCompatRuntimeAfterBuild"
          AfterTargets="Build"
          Condition="Exists('$(AsterPlayLiquidGlassCompatRuntime)')">
    <Copy SourceFiles="$(AsterPlayLiquidGlassCompatRuntime)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"/>
  </Target>

  <Target Name="CopyAsterPlayLiquidGlassCompatRuntimeAfterPublish"
          AfterTargets="Publish"
          Condition="Exists('$(AsterPlayLiquidGlassCompatRuntime)') and '$(PublishDir)' != ''">
    <Copy SourceFiles="$(AsterPlayLiquidGlassCompatRuntime)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"/>
  </Target>
</Project>
