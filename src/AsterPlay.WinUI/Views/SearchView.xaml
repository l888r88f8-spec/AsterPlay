<UserControl
    x:Class="AsterPlay.WinUI.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AsterPlay.WinUI.Controls">

    <Grid Padding="42,30,42,116">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Padding="22"
                CornerRadius="28"
                BorderBrush="#38FFFFFF"
                BorderThickness="1">
            <Border.Background>
                <AcrylicBrush TintColor="#DCE8FA"
                                  TintOpacity="0.055"
                                  TintLuminosityOpacity="0.42"
                                  FallbackColor="#D9DCE8FA"/>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="搜索"
                               Foreground="{ThemeResource AsterPrimaryTextBrush}"
                               FontSize="31"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="搜索电影、剧集和单集"
                               Foreground="{ThemeResource AsterSecondaryTextBrush}"
                               FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox"
                             Height="48"
                             FontSize="16"
                             PlaceholderText="输入标题或关键词"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown"/>

                    <Button Grid.Column="2"
                            Width="92"
                            Height="48"
                            CornerRadius="24"
                            Content="搜索"
                            Click="Search_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <GridView x:Name="ItemsGrid"
                      IsItemClickEnabled="True"
                      SelectionMode="None"
                      ItemClick="ItemsGrid_ItemClick">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="170"
                                    Margin="0,0,14,20"
                                    Spacing="7">
                            <Border Width="170"
                                    Height="250"
                                    CornerRadius="19"
                                    Background="{ThemeResource AsterCardBackgroundBrush}"
                                    BorderBrush="{ThemeResource AsterCardBorderBrush}"
                                    BorderThickness="1">
                                <controls:CachedImage SourceUrl="{Binding PosterUrl}"
                                                      Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="7">
                                <TextBlock Text="{Binding TypeLabel}"
                                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                           FontSize="12"/>
                                <TextBlock Text="{Binding MetaLine}"
                                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel x:Name="SearchHintPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="7">
                <FontIcon Glyph="&#xE721;"
                          FontSize="30"
                          Foreground="{ThemeResource AsterSecondaryTextBrush}"/>
                <TextBlock Text="输入关键词开始搜索"
                           Foreground="{ThemeResource AsterPrimaryTextBrush}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="结果会在停止输入后自动刷新"
                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="EmptyPanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="7">
                <TextBlock Text="没有找到匹配的媒体"
                           Foreground="{ThemeResource AsterPrimaryTextBrush}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyDetailBlock"
                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="8">
                <ProgressRing x:Name="LoadingRing"
                              Width="18"
                              Height="18"
                              IsActive="False"
                              Visibility="Collapsed"/>
                <TextBlock x:Name="SearchStatusBlock"
                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
