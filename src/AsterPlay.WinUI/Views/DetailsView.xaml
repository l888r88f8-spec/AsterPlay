<UserControl
    x:Class="AsterPlay.WinUI.Views.DetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lg="using:LiquidGlassWinUI">

    <Grid>
        <Image x:Name="BackdropImage"
               Stretch="UniformToFill"
               Opacity="0.24"/>

        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#18000000" Offset="0"/>
                    <GradientStop Color="#6A000000" Offset="0.42"/>
                    <GradientStop Color="#B8000000" Offset="0.70"/>
                    <GradientStop Color="{ThemeResource AsterHeroFadeEndColor}" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      ZoomMode="Disabled">
            <StackPanel MaxWidth="1320"
                        HorizontalAlignment="Center"
                        Padding="42,34,42,128"
                        Spacing="34">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="250"
                            Height="370"
                            CornerRadius="22"
                            Background="{ThemeResource AsterCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AsterCardBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Top">
                        <Image x:Name="PosterImage"
                               Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Spacing="10">
                        <Button Content="← 返回"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                Padding="0,4"
                                Click="Back_Click"/>

                        <TextBlock x:Name="TaglineBlock"
                                   Foreground="#D7DAE3"
                                   FontSize="14"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="TitleBlock"
                                   Foreground="White"
                                   FontSize="44"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="OriginalTitleBlock"
                                   Foreground="#B4BBC6"
                                   FontSize="15"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="MetaBlock"
                                   Foreground="#ECEEF3"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="OverviewBlock"
                                   Foreground="#D5D8E1"
                                   FontSize="15"
                                   LineHeight="25"
                                   TextWrapping="Wrap"
                                   MaxHeight="150"/>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="0,8,0,0">
                            <Button x:Name="PlayButton"
                                    MinWidth="118"
                                    Height="42"
                                    CornerRadius="21"
                                    Click="Play_Click"/>
                            <Button x:Name="RestartButton"
                                    Content="从头播放"
                                    Height="42"
                                    CornerRadius="21"
                                    Visibility="Collapsed"
                                    Click="Restart_Click"/>
                            <Button x:Name="FavoriteButton"
                                    Height="42"
                                    CornerRadius="21"
                                    Click="Favorite_Click"/>
                        </StackPanel>

                        <StackPanel x:Name="CreatorPanel"
                                    Visibility="Collapsed"
                                    Margin="0,6,0,0"
                                    Spacing="4">
                            <TextBlock x:Name="DirectorsBlock"
                                       Foreground="#D0D5DE"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="StudiosBlock"
                                       Foreground="#A8B0BC"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="SeriesSection"
                            Visibility="Collapsed"
                            Spacing="14">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="剧集"
                                       Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                       FontSize="25"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="SeriesStatusBlock"
                                       Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <ComboBox x:Name="SeasonComboBox"
                                  HorizontalAlignment="Right"
                                  Width="180"
                                  DisplayMemberPath="Title"
                                  SelectionChanged="SeasonComboBox_SelectionChanged"/>
                    </Grid>

                    <ItemsControl x:Name="EpisodeItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12"
                                        Margin="0,0,0,12"
                                        CornerRadius="18"
                                        Background="{ThemeResource AsterCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource AsterCardBorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="210"
                                                Height="118"
                                                CornerRadius="12"
                                                Background="{ThemeResource AsterCardBackgroundBrush}">
                                            <Image Source="{Binding ImageUrl}"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <TextBlock Text="{Binding EpisodeLabel}"
                                                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding RuntimeLabel}"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                           FontSize="12"/>
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Title}"
                                                       Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0"/>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Overview}"
                                                       Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                       FontSize="13"
                                                       LineHeight="20"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="42"
                                                       Margin="0,7,0,0"/>

                                            <Grid Grid.Row="3"
                                                  Margin="0,10,0,0">
                                                <ProgressBar Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding PlayedPercentage}"
                                                             Height="4"
                                                             VerticalAlignment="Top"/>
                                                <Grid Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding WatchStateLabel}"
                                                               Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                    <Button HorizontalAlignment="Right"
                                                            Content="{Binding PlayLabel}"
                                                            Tag="{Binding}"
                                                            Click="EpisodePlay_Click"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="CastSection"
                            Visibility="Collapsed"
                            Spacing="14">
                    <TextBlock Text="演员"
                               Foreground="{ThemeResource AsterPrimaryTextBrush}"
                               FontSize="23"
                               FontWeight="SemiBold"/>
                    <ScrollViewer HorizontalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  ZoomMode="Disabled">
                        <ItemsControl x:Name="CastItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="120"
                                                Margin="0,0,14,0"
                                                Spacing="6">
                                        <Border Width="112"
                                                Height="150"
                                                CornerRadius="14"
                                                Background="{ThemeResource AsterCardBackgroundBrush}">
                                            <Image Source="{Binding ImageUrl}"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Role}"
                                                   Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                   FontSize="11"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <Grid x:Name="InfoGrid"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="MediaSection"
                                Visibility="Collapsed"
                                Spacing="12">
                        <TextBlock Text="媒体信息"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                        <ItemsControl x:Name="MediaSummaryItems"/>
                    </StackPanel>

                    <StackPanel x:Name="TagsSection"
                                Grid.Column="2"
                                Visibility="Collapsed"
                                Spacing="12">
                        <TextBlock Text="标签与来源"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="GenresBlock"
                                   Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TagsBlock"
                                   Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                        <ItemsControl x:Name="ProviderItems"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay"
              Background="#4A000000">
            <ProgressRing Width="44"
                          Height="44"
                          IsActive="True"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
