<ContentDialog
    x:Class="AsterPlay.WinUI.Views.DanmakuFilterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="弹幕过滤"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="Save_Click">

    <Grid Width="560" MinHeight="410" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="屏蔽词按包含匹配；发送者按 LogVar 返回的 sender/userId 精确匹配。每行填写一项。"
            Foreground="{ThemeResource AsterSecondaryTextBrush}"
            TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Spacing="7">
            <TextBlock Text="屏蔽词" FontWeight="SemiBold"/>
            <TextBox x:Name="BlockedWordsTextBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="135"
                     TextChanged="FilterTextChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="7">
            <TextBlock Text="屏蔽发送者" FontWeight="SemiBold"/>
            <TextBox x:Name="BlockedUsersTextBox"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     MinHeight="125"
                     TextChanged="FilterTextChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <TextBlock x:Name="CountTextBlock"
                   Grid.Row="3"
                   Foreground="{ThemeResource AsterSecondaryTextBrush}"/>
    </Grid>
</ContentDialog>
