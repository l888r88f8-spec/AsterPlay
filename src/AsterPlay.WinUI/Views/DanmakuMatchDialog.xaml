<ContentDialog
    x:Class="AsterPlay.WinUI.Views.DanmakuMatchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LogVar 剧集匹配"
    PrimaryButtonText="绑定剧集"
    SecondaryButtonText="恢复自动匹配"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="UseSelected_Click"
    SecondaryButtonClick="Automatic_Click"
    Loaded="Dialog_Loaded"
    Closed="Dialog_Closed">

    <Grid Width="760" Height="470" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Name="CurrentMediaTextBlock"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="CurrentMatchTextBlock"
                       Foreground="{ThemeResource AsterAccentBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchTextBox"
                     PlaceholderText="输入剧名或关键词"/>
            <Button x:Name="SearchButton"
                    Grid.Column="1"
                    Content="搜索剧集"
                    Click="Search_Click"/>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="1. 选择剧集 / 季度"
                           FontWeight="SemiBold"
                           Margin="2,0,0,8"/>
                <Grid Grid.Row="1">
                    <ListView x:Name="SeriesListBox"
                              SelectionChanged="SeriesListBox_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8" Spacing="4">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DetailText}"
                                               Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="SeriesEmptyTextBlock"
                               Text="输入剧名搜索 LogVar 剧集"
                               Foreground="{ThemeResource AsterSecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </Grid>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="2. 选择当前集"
                           FontWeight="SemiBold"
                           Margin="2,0,0,8"/>
                <Grid Grid.Row="1">
                    <ListView x:Name="EpisodesListBox"
                              DoubleTapped="EpisodesListBox_DoubleTapped"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8" Spacing="4">
                                    <TextBlock Text="{Binding EpisodeTitle}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DetailText}"
                                               Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EpisodesEmptyTextBlock"
                               Text="先选择左侧剧集"
                               Foreground="{ThemeResource AsterSecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="3"
                   Foreground="{ThemeResource AsterSecondaryTextBrush}"
                   TextWrapping="Wrap"/>
    </Grid>
</ContentDialog>
