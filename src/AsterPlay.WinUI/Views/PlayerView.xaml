<UserControl
    x:Class="AsterPlay.WinUI.Views.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AsterPlay.WinUI.Controls"
    Loaded="PlayerView_Loaded"
    Unloaded="PlayerView_Unloaded"
    IsTabStop="True"
    RequestedTheme="Dark"
    KeyDown="PlayerView_KeyDown">

    <UserControl.Resources>
        <Style x:Key="PlayerIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AsterGlassButtonStyle}">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AsterDockBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PlayerPillButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AsterGlassButtonStyle}">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AsterDockBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PlayerRoot"
          Background="Black"
          PointerMoved="PlayerRoot_PointerMoved"
          DoubleTapped="PlayerRoot_DoubleTapped">
        <SwapChainPanel x:Name="VideoPanel"
                        SizeChanged="VideoPanel_SizeChanged"/>

        <controls:WinUIDanmakuOverlay x:Name="DanmakuOverlay"
                                      Visibility="Collapsed"
                                      IsHitTestVisible="False"/>

        <Grid x:Name="TopInfoPanel"
              VerticalAlignment="Top"
              Height="112"
              PointerEntered="InteractiveOverlay_PointerEntered"
              PointerExited="InteractiveOverlay_PointerExited">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="0,1">
                    <GradientStop Color="#D0000000" Offset="0"/>
                    <GradientStop Color="#5A000000" Offset="0.62"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid Margin="24,16,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Top">
                    <Button Style="{StaticResource PlayerIconButtonStyle}"
                            Content="‹"
                            FontSize="28"
                            Click="Back_Click"/>
                    <Border Padding="10,7"
                            CornerRadius="12"
                            Background="#22000000">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="7">
                            <Ellipse Width="6"
                                     Height="6"
                                     Fill="#42D66D"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="NetworkSpeedBlock"
                                       Text="-- MB/s"
                                       Foreground="#E8EBF0"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            MaxWidth="720"
                            Spacing="4">
                    <TextBlock x:Name="TitleBlock"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="EpisodeTitleBlock"
                               Foreground="#AEB5C0"
                               FontSize="12"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Border x:Name="DiagnosticsPanel"
                Width="330"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,24,90"
                Padding="18"
                CornerRadius="20"
                Background="#E91A1C22"
                BorderBrush="#24FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed"
                PointerEntered="InteractiveOverlay_PointerEntered"
                PointerExited="InteractiveOverlay_PointerExited">
            <StackPanel Spacing="8">
                <TextBlock Text="媒体信息"
                           Foreground="White"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBlock Text="播放方式" Foreground="#7E8794" FontSize="11"/>
                <TextBlock x:Name="DiagnosticsMethodBlock" Foreground="White" TextWrapping="Wrap"/>
                <TextBlock Text="视频" Foreground="#7E8794" FontSize="11" Margin="0,4,0,0"/>
                <TextBlock x:Name="DiagnosticsVideoBlock" Foreground="#E7EAF0" TextWrapping="Wrap"/>
                <TextBlock Text="音频" Foreground="#7E8794" FontSize="11" Margin="0,4,0,0"/>
                <TextBlock x:Name="DiagnosticsAudioBlock" Foreground="#E7EAF0" TextWrapping="Wrap"/>
                <TextBlock Text="缓存" Foreground="#7E8794" FontSize="11" Margin="0,4,0,0"/>
                <TextBlock x:Name="DiagnosticsCacheBlock" Foreground="#E7EAF0" TextWrapping="Wrap"/>
                <TextBlock Text="弹幕" Foreground="#7E8794" FontSize="11" Margin="0,4,0,0"/>
                <TextBlock x:Name="DiagnosticsDanmakuBlock" Foreground="#E7EAF0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border x:Name="MoreSettingsPanel"
                Width="390"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,26,196"
                Padding="16"
                CornerRadius="22"
                Visibility="Collapsed"
                PointerEntered="InteractiveOverlay_PointerEntered"
                PointerExited="InteractiveOverlay_PointerExited">
            <Border.Background>
                <AcrylicBrush TintColor="#B9D7FF"
                                  TintOpacity="0.065"
                                  TintLuminosityOpacity="0.34"
                                  FallbackColor="#B9B9D7FF"/>
            </Border.Background>

            <StackPanel Spacing="12">
                <TextBlock Text="播放设置"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <ItemsControl>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button x:Name="DanmakuButton"
                            Style="{StaticResource PlayerPillButtonStyle}"
                            Content="弹幕"
                            Click="Danmaku_Click"/>
                    <Button Style="{StaticResource PlayerPillButtonStyle}"
                            Content="弹幕设置"
                            Click="DanmakuSettings_Click"/>
                    <Button Style="{StaticResource PlayerPillButtonStyle}"
                            Content="LogVar"
                            Click="DanmakuSource_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <Button Style="{StaticResource PlayerPillButtonStyle}"
                            Content="匹配"
                            Click="DanmakuMatch_Click"/>
                    <Button Style="{StaticResource PlayerPillButtonStyle}"
                            Content="过滤"
                            Click="DanmakuFilter_Click"/>
                    <Button Style="{StaticResource PlayerPillButtonStyle}"
                            Content="详细信息"
                            Click="Diagnostics_Click"/>
                    <Button x:Name="FullscreenButton"
                            Style="{StaticResource PlayerPillButtonStyle}"
                            Content="全屏"
                            Click="Fullscreen_Click"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MuteButton"
                            Style="{StaticResource PlayerIconButtonStyle}"
                            Content="🔊"
                            Click="Mute_Click"/>
                    <Slider x:Name="VolumeSlider"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid x:Name="ControlsPanel"
              Height="204"
              VerticalAlignment="Bottom"
              PointerEntered="InteractiveOverlay_PointerEntered"
              PointerExited="InteractiveOverlay_PointerExited">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#88000000" Offset="0.34"/>
                    <GradientStop Color="#F5000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid Margin="24,12,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="58"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button x:Name="SubtitleButton"
                            Style="{StaticResource PlayerIconButtonStyle}"
                            Content="CC"
                            FontSize="12"
                            Click="Subtitle_Click"/>
                    <Button x:Name="AudioButton"
                            Style="{StaticResource PlayerIconButtonStyle}"
                            Content="♫"
                            Click="Audio_Click"/>
                    <Button x:Name="MoreSettingsButton"
                            Style="{StaticResource PlayerIconButtonStyle}"
                            Content="•••"
                            Click="MoreSettings_Click"/>
                </StackPanel>

                <Grid Grid.Row="1"
                      Margin="2,0">
                    <ProgressBar x:Name="BufferedProgressBar"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="0"
                                 Height="4"
                                 VerticalAlignment="Center"
                                 Background="#28FFFFFF"
                                 Foreground="#6AFFFFFF"
                                 BorderThickness="0"/>
                    <Canvas x:Name="DanmakuHeatmapCanvas"
                            Height="18"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Opacity="0.64"/>
                    <Slider x:Name="PositionSlider"
                            Minimum="0"
                            Maximum="1"
                            VerticalAlignment="Center"
                            ValueChanged="PositionSlider_ValueChanged"
                            PointerPressed="PositionSlider_PointerPressed"
                            PointerReleased="PositionSlider_PointerReleased"/>
                </Grid>

                <Grid Grid.Row="2"
                      Margin="2,0">
                    <TextBlock x:Name="CurrentTimeBlock"
                               Text="00:00"
                               Foreground="#B8BEC8"
                               FontSize="11"/>
                    <TextBlock x:Name="DurationBlock"
                               Text="--:--"
                               Foreground="#B8BEC8"
                               FontSize="11"
                               HorizontalAlignment="Right"/>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <ComboBox x:Name="SpeedComboBox"
                                  Width="82"
                                  Height="42"
                                  SelectionChanged="SpeedComboBox_SelectionChanged">
                            <ComboBoxItem Content="0.5×" Tag="0.5"/>
                            <ComboBoxItem Content="0.75×" Tag="0.75"/>
                            <ComboBoxItem Content="1.0×" Tag="1"/>
                            <ComboBoxItem Content="1.25×" Tag="1.25"/>
                            <ComboBoxItem Content="1.5×" Tag="1.5"/>
                            <ComboBoxItem Content="2.0×" Tag="2"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource PlayerIconButtonStyle}"
                                Content="↶"
                                Click="SeekBack_Click"/>
                        <Button x:Name="PreviousEpisodeButton"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                Content="⏮"
                                Click="PreviousEpisode_Click"/>
                        <Button x:Name="PlayPauseButton"
                                Width="54"
                                Height="54"
                                CornerRadius="18"
                                Content="⏸"
                                FontSize="20"
                                Click="PlayPause_Click"/>
                        <Button x:Name="NextEpisodeButton"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                Content="⏭"
                                Click="NextEpisode_Click"/>
                        <Button Style="{StaticResource PlayerIconButtonStyle}"
                                Content="↷"
                                Click="SeekForward_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button x:Name="ResolutionButton"
                                Style="{StaticResource PlayerPillButtonStyle}"
                                Content="--"
                                Click="Diagnostics_Click"/>
                        <Button x:Name="EpisodeListButton"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                Content="☷"
                                Click="EpisodeList_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusBlock"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,212"
                   Foreground="#AAB3C1"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Text="正在初始化 D3D11 composition…"/>
    </Grid>
</UserControl>
