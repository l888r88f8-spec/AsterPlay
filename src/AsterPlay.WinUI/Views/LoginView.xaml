<UserControl
    x:Class="AsterPlay.WinUI.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="64,42,64,116">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="460"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center"
                    MaxWidth="640"
                    Spacing="18">
            <Border Width="68"
                    Height="68"
                    HorizontalAlignment="Left"
                    CornerRadius="22">
                <Border.Background>
                    <AcrylicBrush TintColor="#509BFF"
                                  TintOpacity="0.160"
                                  TintLuminosityOpacity="0.52"
                                  FallbackColor="#E6509BFF"/>
                </Border.Background>
                <TextBlock Text="A"
                           Foreground="White"
                           FontSize="32"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="你的媒体，保持安静。"
                       Foreground="{ThemeResource AsterPrimaryTextBrush}"
                       FontSize="46"
                       FontWeight="SemiBold"/>
            <TextBlock Text="连接 Emby，浏览、播放并同步你的私人媒体库。新的 WinUI 3 界面使用 Windows 原生 Composition 与液态玻璃材质。"
                       Foreground="{ThemeResource AsterSecondaryTextBrush}"
                       FontSize="17"
                       LineHeight="27"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Column="2"
                Padding="30"
                CornerRadius="30"
                VerticalAlignment="Center">
            <Border.Background>
                <AcrylicBrush TintColor="#C3DCFF"
                                  TintOpacity="0.090"
                                  TintLuminosityOpacity="0.52"
                                  FallbackColor="#D9C3DCFF"/>
            </Border.Background>

            <StackPanel Spacing="12">
                <TextBlock Text="登录"
                           Foreground="{ThemeResource AsterPrimaryTextBrush}"
                           FontSize="30"
                           FontWeight="SemiBold"/>
                <TextBlock Text="选择已保存服务器，或输入新的地址。"
                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                           Margin="0,0,0,10"/>

                <TextBlock Text="已保存服务器" Foreground="{ThemeResource AsterSecondaryTextBrush}"/>
                <ComboBox x:Name="SavedServerBox"
                          Height="42"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="SavedServerBox_SelectionChanged"/>

                <TextBlock Text="服务器地址"
                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                           Margin="0,8,0,0"/>
                <TextBox x:Name="ServerUrlBox"
                         Height="42"
                         Text="http://127.0.0.1:8096"/>

                <Button Content="管理服务器"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#7CC0FF"
                        Padding="0,4"
                        Click="ManageServers_Click"/>

                <TextBlock Text="用户名"
                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                           Margin="0,8,0,0"/>
                <TextBox x:Name="UserNameBox" Height="42"/>

                <TextBlock Text="密码"
                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                           Margin="0,8,0,0"/>
                <PasswordBox x:Name="PasswordBox" Height="42"/>

                <TextBlock x:Name="MessageBlock"
                           Foreground="#FF9A9A"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <Button x:Name="LoginButton"
                        Content="登录"
                        Height="46"
                        Margin="0,10,0,0"
                        Click="Login_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
