<UserControl
    x:Class="AsterPlay.WinUI.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lg="using:LiquidGlassWinUI">

    <Grid Padding="64,42,64,116">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="460"/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center"
                    MaxWidth="640"
                    Spacing="18">
            <Border Width="68"
                    Height="68"
                    HorizontalAlignment="Left"
                    CornerRadius="22">
                <Border.Background>
                    <lg:LiquidGlassBrush BlurAmount="1.4"
                                         BloomAmount="0.24"
                                         RefThickness="22"
                                         RefFactor="1.9"
                                         RefDispersion="4"
                                         GlareFactor="68"
                                         TintA="0.16"
                                         TintR="80"
                                         TintG="155"
                                         TintB="255"
                                         ShapeRadius="0.94"
                                         ShapeRoundness="3.8"/>
                </Border.Background>
                <TextBlock Text="A"
                           Foreground="White"
                           FontSize="32"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="你的媒体，保持安静。"
                       Foreground="White"
                       FontSize="46"
                       FontWeight="SemiBold"/>
            <TextBlock Text="连接 Emby，浏览、播放并同步你的私人媒体库。新的 WinUI 3 界面使用 Windows 原生 Composition 与液态玻璃材质。"
                       Foreground="#A7AFBD"
                       FontSize="17"
                       LineHeight="27"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Column="2"
                Padding="30"
                CornerRadius="30"
                VerticalAlignment="Center">
            <Border.Background>
                <lg:LiquidGlassBrush BlurAmount="1.8"
                                     BloomAmount="0.18"
                                     RefThickness="38"
                                     RefFactor="2.2"
                                     RefDispersion="4.5"
                                     DispersionRange="0.42"
                                     RefFresnelFactor="24"
                                     GlareFactor="66"
                                     GlareAngle="-140"
                                     TintA="0.09"
                                     TintR="195"
                                     TintG="220"
                                     TintB="255"
                                     ShapeRadius="0.90"
                                     ShapeRoundness="3.7"/>
            </Border.Background>

            <StackPanel Spacing="12">
                <TextBlock Text="登录"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="SemiBold"/>
                <TextBlock Text="选择已保存服务器，或输入新的地址。"
                           Foreground="#A8B0BE"
                           Margin="0,0,0,10"/>

                <TextBlock Text="已保存服务器" Foreground="#C9CFD8"/>
                <ComboBox x:Name="SavedServerBox"
                          Height="42"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="SavedServerBox_SelectionChanged"/>

                <TextBlock Text="服务器地址"
                           Foreground="#C9CFD8"
                           Margin="0,8,0,0"/>
                <TextBox x:Name="ServerUrlBox"
                         Height="42"
                         Text="http://127.0.0.1:8096"/>

                <Button Content="管理服务器"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#7CC0FF"
                        Padding="0,4"
                        Click="ManageServers_Click"/>

                <TextBlock Text="用户名"
                           Foreground="#C9CFD8"
                           Margin="0,8,0,0"/>
                <TextBox x:Name="UserNameBox" Height="42"/>

                <TextBlock Text="密码"
                           Foreground="#C9CFD8"
                           Margin="0,8,0,0"/>
                <PasswordBox x:Name="PasswordBox" Height="42"/>

                <TextBlock x:Name="MessageBlock"
                           Foreground="#FF9A9A"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <Button x:Name="LoginButton"
                        Content="登录"
                        Height="46"
                        Margin="0,10,0,0"
                        Click="Login_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
