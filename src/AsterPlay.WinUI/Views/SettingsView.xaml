<UserControl
    x:Class="AsterPlay.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lg="using:LiquidGlassWinUI">

    <ScrollViewer>
        <StackPanel Padding="48,34,48,126"
                    MaxWidth="940"
                    HorizontalAlignment="Left"
                    Spacing="18">
            <StackPanel>
                <TextBlock Text="设置"
                           Foreground="White"
                           FontSize="36"
                           FontWeight="SemiBold"/>
                <TextBlock Text="应用与播放偏好"
                           Foreground="#9FA8B6"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Padding="26" CornerRadius="28">
                <Border.Background>
                    <lg:LiquidGlassBrush BlurAmount="1.6"
                                         BloomAmount="0.16"
                                         RefThickness="34"
                                         RefFactor="2.0"
                                         RefDispersion="4"
                                         GlareFactor="58"
                                         TintA="0.08"
                                         ShapeRadius="0.88"
                                         ShapeRoundness="3.8"/>
                </Border.Background>
                <StackPanel Spacing="14">
                    <TextBlock Text="常规"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="SemiBold"/>
                    <CheckBox x:Name="RestoreSessionCheckBox"
                              Content="启动时恢复上次登录"
                              Checked="SettingChanged"
                              Unchecked="SettingChanged"/>
                    <TextBlock Text="Access Token 继续使用当前 Windows 用户的 DPAPI 保护。"
                               Foreground="#8993A3"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Padding="26" CornerRadius="28">
                <Border.Background>
                    <lg:LiquidGlassBrush BlurAmount="1.6"
                                         BloomAmount="0.16"
                                         RefThickness="34"
                                         RefFactor="2.0"
                                         RefDispersion="4"
                                         GlareFactor="58"
                                         TintA="0.08"
                                         ShapeRadius="0.88"
                                         ShapeRoundness="3.8"/>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Text="播放器"
                                   Foreground="White"
                                   FontSize="19"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="控制栏自动隐藏"
                                   Foreground="#E9EDF3"/>
                        <TextBlock Text="鼠标静止后隐藏播放控制层。"
                                   Foreground="#8993A3"/>
                    </StackPanel>
                    <ComboBox x:Name="AutoHideComboBox"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              SelectionChanged="SettingChanged">
                        <ComboBoxItem Tag="2" Content="2 秒"/>
                        <ComboBoxItem Tag="3" Content="3 秒"/>
                        <ComboBoxItem Tag="5" Content="5 秒"/>
                        <ComboBoxItem Tag="8" Content="8 秒"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Padding="26" CornerRadius="28">
                <Border.Background>
                    <lg:LiquidGlassBrush BlurAmount="1.5"
                                         BloomAmount="0.14"
                                         RefThickness="30"
                                         RefFactor="1.9"
                                         RefDispersion="3.5"
                                         GlareFactor="52"
                                         TintA="0.07"
                                         ShapeRadius="0.88"
                                         ShapeRoundness="3.8"/>
                </Border.Background>
                <StackPanel Spacing="6">
                    <TextBlock Text="关于"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="AsterPlay · WinUI 3 · .NET 8"
                               Foreground="#E9EDF3"/>
                    <TextBlock Text="Windows App SDK 2.2.0 · LiquidGlassWinUI 1.0.3"
                               Foreground="#8993A3"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
