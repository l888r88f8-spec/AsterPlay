<UserControl
    x:Class="AsterPlay.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="48,34,48,126"
                    MaxWidth="940"
                    HorizontalAlignment="Left"
                    Spacing="18">
            <StackPanel>
                <TextBlock Text="设置"
                           Foreground="{ThemeResource AsterPrimaryTextBrush}"
                           FontSize="36"
                           FontWeight="SemiBold"/>
                <TextBlock Text="应用与播放偏好"
                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Padding="26" CornerRadius="28">
                <Border.Background>
                    <AcrylicBrush TintColor="#F0F2F8"
                                  TintOpacity="0.050"
                                  TintLuminosityOpacity="0.30"
                                  FallbackColor="#B9F0F2F8"/>
                </Border.Background>
                <StackPanel Spacing="14">
                    <TextBlock Text="常规"
                               Foreground="{ThemeResource AsterPrimaryTextBrush}"
                               FontSize="19"
                               FontWeight="SemiBold"/>
                    <CheckBox x:Name="RestoreSessionCheckBox"
                              Content="启动时恢复上次登录"
                              Checked="SettingChanged"
                              Unchecked="SettingChanged"/>
                    <TextBlock Text="Access Token 继续使用当前 Windows 用户的 DPAPI 保护。"
                               Foreground="{ThemeResource AsterSecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Padding="26" CornerRadius="28">
                <Border.Background>
                    <AcrylicBrush TintColor="#F0F2F8"
                                  TintOpacity="0.050"
                                  TintLuminosityOpacity="0.30"
                                  FallbackColor="#B9F0F2F8"/>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Text="播放器"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                   FontSize="19"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="控制栏自动隐藏"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"/>
                        <TextBlock Text="鼠标静止后隐藏播放控制层。"
                                   Foreground="{ThemeResource AsterSecondaryTextBrush}"/>
                    </StackPanel>
                    <ComboBox x:Name="AutoHideComboBox"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              SelectionChanged="SettingChanged">
                        <ComboBoxItem Tag="2" Content="2 秒"/>
                        <ComboBoxItem Tag="3" Content="3 秒"/>
                        <ComboBoxItem Tag="5" Content="5 秒"/>
                        <ComboBoxItem Tag="8" Content="8 秒"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Padding="26" CornerRadius="28">
                <Border.Background>
                    <AcrylicBrush TintColor="#F0F2F8"
                                  TintOpacity="0.045"
                                  TintLuminosityOpacity="0.30"
                                  FallbackColor="#B9F0F2F8"/>
                </Border.Background>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="账户"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                   FontSize="19"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="清除当前登录状态并返回登录页。"
                                   Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Content="退出登录"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="Logout_Click"/>
                </Grid>
            </Border>

            <Border Padding="26" CornerRadius="28">
                <Border.Background>
                    <AcrylicBrush TintColor="#F0F2F8"
                                  TintOpacity="0.045"
                                  TintLuminosityOpacity="0.30"
                                  FallbackColor="#B9F0F2F8"/>
                </Border.Background>
                <StackPanel Spacing="6">
                    <TextBlock Text="关于"
                               Foreground="{ThemeResource AsterPrimaryTextBrush}"
                               FontSize="19"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="AsterPlay · WinUI 3 · .NET 8"
                               Foreground="{ThemeResource AsterPrimaryTextBrush}"/>
                    <TextBlock Text="Windows App SDK 2.5.1 · WinUI Acrylic"
                               Foreground="{ThemeResource AsterSecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
