<UserControl
    x:Class="AsterPlay.WinUI.Views.ServerManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lg="using:LiquidGlassWinUI"
    xmlns:controls="using:AsterPlay.WinUI.Controls"
    Loaded="ServerManagementView_Loaded">

    <UserControl.Resources>
        <lg:LiquidGlassBrush x:Key="ServerCardGlassBrush"
                             BlurAmount="1.65"
                             BloomAmount="0.08"
                             RefThickness="30"
                             RefFactor="1.90"
                             RefDispersion="2.6"
                             DispersionRange="0.28"
                             RefFresnelFactor="18"
                             GlareFactor="40"
                             TintA="0.19"
                             TintR="239"
                             TintG="242"
                             TintB="247"
                             ShapeRadius="0.22"
                             ShapeRoundness="4.0"/>

        <Style x:Key="CircleActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AsterGlassButtonStyle}">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AsterDockBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ServerCardButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AsterGlassButtonStyle}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="216"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="RefreshPillButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AsterGlassButtonStyle}">
            <Setter Property="Width" Value="320"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AsterDockBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{ThemeResource AsterPrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ServerEditorFieldStyle"
               TargetType="TextBox">
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{ThemeResource AsterControlFillBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource AsterPrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style x:Key="ServerEditorPasswordStyle"
               TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{ThemeResource AsterControlFillBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource AsterPrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style x:Key="ServerEditorProtocolStyle"
               TargetType="ComboBox">
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AsterDockBorderBrush}"/>
            <Setter Property="Background" Value="{ThemeResource AsterCardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource AsterPrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="ServerEditorHeaderButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CircleActionButtonStyle}">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="CornerRadius" Value="27"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root"
          Background="{ThemeResource AsterPageBackgroundBrush}"
          SizeChanged="Root_SizeChanged">
        <ScrollViewer VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      ZoomMode="Disabled">
            <Grid x:Name="PageContent"
                  Padding="48,28,48,124">
                <StackPanel>
                    <Grid Margin="0,4,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PageTitle"
                                   Text="服务器"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                   FontSize="40"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="12">
                            <Button x:Name="SortButton"
                                    Style="{StaticResource CircleActionButtonStyle}"
                                    Click="Sort_Click"
                                    ToolTipService.ToolTip="按名称排序">
                                <FontIcon Glyph="&#xE8CB;"
                                          FontSize="21"
                                          Foreground="{ThemeResource AsterPrimaryTextBrush}"/>
                            </Button>

                            <Button x:Name="LayoutButton"
                                    Style="{StaticResource CircleActionButtonStyle}"
                                    Click="Layout_Click"
                                    ToolTipService.ToolTip="切换卡片密度">
                                <FontIcon Glyph="&#xE8FD;"
                                          FontSize="21"
                                          Foreground="{ThemeResource AsterPrimaryTextBrush}"/>
                            </Button>

                            <Button x:Name="AddButton"
                                    Style="{StaticResource CircleActionButtonStyle}"
                                    Click="Add_Click"
                                    ToolTipService.ToolTip="添加服务器">
                                <FontIcon Glyph="&#xE710;"
                                          FontSize="21"
                                          Foreground="{ThemeResource AsterPrimaryTextBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsRepeater x:Name="ServerCards"
                                   HorizontalAlignment="Stretch">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="330"
                                               MinItemHeight="216"
                                               MinColumnSpacing="18"
                                               MinRowSpacing="18"
                                               ItemsJustification="Start"
                                               ItemsStretch="None"/>
                        </ItemsRepeater.Layout>

                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding CardWidth}"
                                      Height="{Binding CardHeight}">
                                    <Button Style="{StaticResource ServerCardButtonStyle}"
                                            Width="{Binding CardWidth}"
                                            Height="{Binding CardHeight}"
                                            Tag="{Binding}"
                                            Click="ServerCard_Click"
                                            ToolTipService.ToolTip="{Binding Url}">
                                        <Border CornerRadius="26"
                                                Background="{StaticResource ServerCardGlassBrush}"
                                                BorderBrush="{Binding CardBorderBrush}"
                                                BorderThickness="{Binding CardBorderThickness}">
                                            <Grid Padding="22,18,22,18">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="44"
                                                            Height="44"
                                                            CornerRadius="12"
                                                            Background="{ThemeResource AsterCardBackgroundBrush}"
                                                            BorderBrush="{ThemeResource AsterDockBorderBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE7F8;"
                                                                      FontSize="20"
                                                                      Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                            <controls:CachedImage SourceUrl="{Binding AvatarUrl}"
                                                                                  LazyLoadingEnabled="False"
                                                                                  Stretch="UniformToFill"
                                                                                  CornerRadius="12"/>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Spacing="7"
                                                                VerticalAlignment="Top"
                                                                Margin="0,2,34,0">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                        <Ellipse Width="8"
                                                                 Height="8"
                                                                 Fill="{Binding StatusBrush}"
                                                                 VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding DisplayName}"
                                                           Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                           FontSize="24"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,12,0,12"/>

                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding MetaText}"
                                                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <Button Width="34"
                                            Height="34"
                                            MinWidth="34"
                                            MinHeight="34"
                                            Padding="0"
                                            CornerRadius="17"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,12,12,0"
                                            Tag="{Binding}"
                                            Click="More_Click"
                                            ToolTipService.ToolTip="更多">
                                        <FontIcon Glyph="&#xE712;"
                                                  FontSize="16"
                                                  Foreground="{ThemeResource AsterSecondaryTextBrush}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Button x:Name="RefreshButton"
                            Style="{StaticResource RefreshPillButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,32,0,0"
                            Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    HorizontalAlignment="Center">
                            <Grid Width="19"
                                  Height="19">
                                <FontIcon x:Name="RefreshIcon"
                                          Glyph="&#xE72C;"
                                          FontSize="17"
                                          Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                <ProgressRing x:Name="RefreshProgress"
                                              Width="18"
                                              Height="18"
                                              IsActive="False"
                                              Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="RefreshLabel"
                                       Text="刷新服务器数据"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="FooterText"
                               Text=""
                               Foreground="{ThemeResource AsterSecondaryTextBrush}"
                               FontSize="13"
                               Opacity="0.68"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Keep the no-server prompt centered in the viewport, not in the scroll content. -->
        <Grid x:Name="EmptyState"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <TextBlock Text="请先添加服务器"
                       FontSize="20"
                       FontWeight="Normal"
                       Foreground="{ThemeResource AsterTertiaryTextBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="24,0"/>
        </Grid>

        <!-- Full-page server sign-in editor, modeled after the supplied mobile
             layout while retaining responsive desktop margins. -->
        <Grid x:Name="ServerEditor"
              Background="{ThemeResource AsterPageBackgroundBrush}"
              Visibility="Collapsed"
              Canvas.ZIndex="20">
            <ScrollViewer VerticalScrollMode="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          ZoomMode="Disabled">
                <Grid MaxWidth="820"
                      HorizontalAlignment="Center"
                      Padding="34,28,34,128">
                    <StackPanel Spacing="0">
                        <Grid Margin="0,0,0,42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="EditorBackButton"
                                    Style="{StaticResource ServerEditorHeaderButtonStyle}"
                                    Click="EditorBack_Click"
                                    ToolTipService.ToolTip="返回服务器列表">
                                <FontIcon Glyph="&#xE72B;"
                                          FontSize="25"
                                          Foreground="{ThemeResource AsterPrimaryTextBrush}"/>
                            </Button>

                            <TextBlock x:Name="EditorTitle"
                                       Grid.Column="1"
                                       Text="登录服务器"
                                       FontSize="38"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="24,0"/>

                            <Button x:Name="EditorSaveButton"
                                    Grid.Column="2"
                                    Style="{StaticResource ServerEditorHeaderButtonStyle}"
                                    Click="EditorSave_Click"
                                    ToolTipService.ToolTip="保存并登录">
                                <Grid Width="26"
                                      Height="26">
                                    <FontIcon x:Name="EditorSaveIcon"
                                              Glyph="&#xE74E;"
                                              FontSize="24"
                                              Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    <ProgressRing x:Name="EditorSaveProgress"
                                                  Width="24"
                                                  Height="24"
                                                  IsActive="False"
                                                  Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                        </Grid>

                        <StackPanel Spacing="10">
                            <TextBlock FontSize="18">
                                <Run Text="服务器名称"/>
                                <Run Text="（可选）"
                                     Foreground="{ThemeResource AsterTertiaryTextBrush}"/>
                            </TextBlock>
                            <TextBox x:Name="EditorNameBox"
                                     Style="{StaticResource ServerEditorFieldStyle}"
                                     PlaceholderText="为服务器起个名字"/>
                        </StackPanel>

                        <StackPanel Margin="0,28,0,0"
                                    Spacing="10">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <TextBlock Text="服务器地址"
                                           FontSize="18"/>
                                <TextBlock Text="*"
                                           FontSize="18"
                                           Foreground="#F04B36"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="9"
                                        Margin="2,4,0,0">
                                <FontIcon Glyph="&#xE80F;"
                                          FontSize="17"
                                          Foreground="{ThemeResource AsterSecondaryTextBrush}"/>
                                <TextBlock Text="主机地址"
                                           FontSize="16"
                                           Foreground="{ThemeResource AsterSecondaryTextBrush}"/>
                            </StackPanel>
                            <TextBox x:Name="EditorHostBox"
                                     Style="{StaticResource ServerEditorFieldStyle}"
                                     PlaceholderText="例如：192.168.1.100 或 emby.example.com"
                                     InputScope="Url"/>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="9"
                                                Margin="2,0,0,0">
                                        <FontIcon Glyph="&#xE72E;"
                                                  FontSize="17"
                                                  Foreground="{ThemeResource AsterSecondaryTextBrush}"/>
                                        <TextBlock Text="协议"
                                                   FontSize="16"
                                                   Foreground="{ThemeResource AsterSecondaryTextBrush}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="EditorProtocolBox"
                                              Style="{StaticResource ServerEditorProtocolStyle}"
                                              SelectedIndex="0"
                                              SelectionChanged="EditorProtocol_SelectionChanged">
                                        <ComboBoxItem Content="http://"/>
                                        <ComboBoxItem Content="https://"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Spacing="10">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="9"
                                                Margin="2,0,0,0">
                                        <FontIcon Glyph="&#xE946;"
                                                  FontSize="17"
                                                  Foreground="{ThemeResource AsterSecondaryTextBrush}"/>
                                        <TextBlock FontSize="16">
                                            <Run Text="端口"/>
                                            <Run Text="（可选）"
                                                 Foreground="{ThemeResource AsterTertiaryTextBrush}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBox x:Name="EditorPortBox"
                                             Style="{StaticResource ServerEditorFieldStyle}"
                                             PlaceholderText="8096"
                                             InputScope="Number"
                                             MaxLength="5"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="9"
                                        Margin="2,10,0,0">
                                <FontIcon Glyph="&#xE8B7;"
                                          FontSize="17"
                                          Foreground="{ThemeResource AsterSecondaryTextBrush}"/>
                                <TextBlock FontSize="16">
                                    <Run Text="路径"/>
                                    <Run Text="（可选）"
                                         Foreground="{ThemeResource AsterTertiaryTextBrush}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBox x:Name="EditorPathBox"
                                     Style="{StaticResource ServerEditorFieldStyle}"
                                     PlaceholderText="/emby 或 /jellyfin"
                                     InputScope="Url"/>
                        </StackPanel>

                        <StackPanel Margin="0,28,0,0"
                                    Spacing="10">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <TextBlock Text="用户名"
                                           FontSize="18"/>
                                <TextBlock Text="*"
                                           FontSize="18"
                                           Foreground="#F04B36"/>
                            </StackPanel>
                            <TextBox x:Name="EditorUserNameBox"
                                     Style="{StaticResource ServerEditorFieldStyle}"
                                     PlaceholderText="账号用户名"/>
                        </StackPanel>

                        <StackPanel Margin="0,28,0,0"
                                    Spacing="10">
                            <TextBlock FontSize="18">
                                <Run Text="密码"/>
                                <Run Text="（可选）"
                                     Foreground="{ThemeResource AsterTertiaryTextBrush}"/>
                            </TextBlock>
                            <PasswordBox x:Name="EditorPasswordBox"
                                         Style="{StaticResource ServerEditorPasswordStyle}"
                                         PlaceholderText="账号密码"
                                         PasswordRevealMode="Peek"/>
                        </StackPanel>

                        <TextBlock x:Name="EditorValidationText"
                                   Text=""
                                   Foreground="#D64848"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="2,18,2,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
