<UserControl
    x:Class="AsterPlay.WinUI.Views.ServerManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lg="using:LiquidGlassWinUI"
    xmlns:controls="using:AsterPlay.WinUI.Controls"
    Loaded="ServerManagementView_Loaded">

    <UserControl.Resources>
        <lg:LiquidGlassBrush x:Key="ServerCardGlassBrush"
                             BlurAmount="1.65"
                             BloomAmount="0.08"
                             RefThickness="30"
                             RefFactor="1.90"
                             RefDispersion="2.6"
                             DispersionRange="0.28"
                             RefFresnelFactor="18"
                             GlareFactor="40"
                             TintA="0.19"
                             TintR="239"
                             TintG="242"
                             TintB="247"
                             ShapeRadius="0.22"
                             ShapeRoundness="4.0"/>

        <Style x:Key="CircleActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AsterGlassButtonStyle}">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AsterDockBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ServerCardButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AsterGlassButtonStyle}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="216"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="RefreshPillButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AsterGlassButtonStyle}">
            <Setter Property="Width" Value="320"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AsterDockBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{ThemeResource AsterPrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root"
          Background="{ThemeResource AsterPageBackgroundBrush}"
          SizeChanged="Root_SizeChanged">
        <ScrollViewer VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      ZoomMode="Disabled">
            <Grid x:Name="PageContent"
                  Padding="48,28,48,124">
                <StackPanel>
                    <Grid Margin="0,4,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PageTitle"
                                   Text="服务器"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                   FontSize="40"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="12">
                            <Button x:Name="SortButton"
                                    Style="{StaticResource CircleActionButtonStyle}"
                                    Click="Sort_Click"
                                    ToolTipService.ToolTip="按名称排序">
                                <FontIcon Glyph="&#xE8CB;"
                                          FontSize="21"
                                          Foreground="{ThemeResource AsterPrimaryTextBrush}"/>
                            </Button>

                            <Button x:Name="LayoutButton"
                                    Style="{StaticResource CircleActionButtonStyle}"
                                    Click="Layout_Click"
                                    ToolTipService.ToolTip="切换卡片密度">
                                <FontIcon Glyph="&#xE8FD;"
                                          FontSize="21"
                                          Foreground="{ThemeResource AsterPrimaryTextBrush}"/>
                            </Button>

                            <Button x:Name="AddButton"
                                    Style="{StaticResource CircleActionButtonStyle}"
                                    Click="Add_Click"
                                    ToolTipService.ToolTip="添加服务器">
                                <FontIcon Glyph="&#xE710;"
                                          FontSize="21"
                                          Foreground="{ThemeResource AsterPrimaryTextBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsRepeater x:Name="ServerCards"
                                   HorizontalAlignment="Stretch">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="330"
                                               MinItemHeight="216"
                                               MinColumnSpacing="18"
                                               MinRowSpacing="18"
                                               ItemsJustification="Start"
                                               ItemsStretch="None"/>
                        </ItemsRepeater.Layout>

                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding CardWidth}"
                                      Height="{Binding CardHeight}">
                                    <Button Style="{StaticResource ServerCardButtonStyle}"
                                            Width="{Binding CardWidth}"
                                            Height="{Binding CardHeight}"
                                            Tag="{Binding}"
                                            Click="ServerCard_Click"
                                            ToolTipService.ToolTip="{Binding Url}">
                                        <Border CornerRadius="26"
                                                Background="{StaticResource ServerCardGlassBrush}"
                                                BorderBrush="{Binding CardBorderBrush}"
                                                BorderThickness="{Binding CardBorderThickness}">
                                            <Grid Padding="22,18,22,18">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="44"
                                                            Height="44"
                                                            CornerRadius="12"
                                                            Background="{ThemeResource AsterCardBackgroundBrush}"
                                                            BorderBrush="{ThemeResource AsterDockBorderBrush}"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE7F8;"
                                                                      FontSize="20"
                                                                      Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                            <controls:CachedImage SourceUrl="{Binding AvatarUrl}"
                                                                                  LazyLoadingEnabled="False"
                                                                                  Stretch="UniformToFill"
                                                                                  CornerRadius="12"/>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Spacing="7"
                                                                VerticalAlignment="Top"
                                                                Margin="0,2,34,0">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                        <Ellipse Width="8"
                                                                 Height="8"
                                                                 Fill="{Binding StatusBrush}"
                                                                 VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding DisplayName}"
                                                           Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                           FontSize="24"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,12,0,12"/>

                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding MetaText}"
                                                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <Button Width="34"
                                            Height="34"
                                            MinWidth="34"
                                            MinHeight="34"
                                            Padding="0"
                                            CornerRadius="17"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,12,12,0"
                                            Tag="{Binding}"
                                            Click="More_Click"
                                            ToolTipService.ToolTip="更多">
                                        <FontIcon Glyph="&#xE712;"
                                                  FontSize="16"
                                                  Foreground="{ThemeResource AsterSecondaryTextBrush}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Grid x:Name="EmptyState"
                          Visibility="Collapsed"
                          MinHeight="270">
                        <TextBlock Text="请先添加服务器"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </Grid>

                    <Button x:Name="RefreshButton"
                            Style="{StaticResource RefreshPillButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,32,0,0"
                            Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    HorizontalAlignment="Center">
                            <Grid Width="19"
                                  Height="19">
                                <FontIcon x:Name="RefreshIcon"
                                          Glyph="&#xE72C;"
                                          FontSize="17"
                                          Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                <ProgressRing x:Name="RefreshProgress"
                                              Width="18"
                                              Height="18"
                                              IsActive="False"
                                              Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="RefreshLabel"
                                       Text="刷新服务器数据"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="FooterText"
                               Text=""
                               Foreground="{ThemeResource AsterSecondaryTextBrush}"
                               FontSize="13"
                               Opacity="0.68"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
