<UserControl
    x:Class="AsterPlay.WinUI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lg="using:LiquidGlassWinUI"
    xmlns:controls="using:AsterPlay.WinUI.Controls">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                         Color="#14000000"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                         Color="#22000000"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                         Color="#44FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                         Color="#55FFFFFF"/>

        <!-- A deliberately minimal button template. It keeps the supplied glass
             brush stable across hover/pressed states and prevents media tiles
             from receiving WinUI's default rectangular pointer fill. -->
        <ControlTemplate x:Key="FlatButtonTemplate"
                         TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="RoundActionButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Foreground" Value="{ThemeResource AsterRailArrowForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AsterRailArrowBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background">
                <Setter.Value>
                    <lg:LiquidGlassBrush BlurAmount="2.75"
                                         BloomAmount="0.12"
                                         RefThickness="26"
                                         RefFactor="1.95"
                                         RefDispersion="4.2"
                                         GlareFactor="54"
                                         TintA="0.055"
                                         TintR="205"
                                         TintG="225"
                                         TintB="255"
                                         ShapeRadius="0.98"
                                         ShapeRoundness="3.9"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionMoreButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#34FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{ThemeResource AsterPrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background">
                <Setter.Value>
                    <lg:LiquidGlassBrush BlurAmount="3.6"
                                         BloomAmount="0.08"
                                         RefThickness="24"
                                         RefFactor="1.75"
                                         RefDispersion="3.6"
                                         GlareFactor="46"
                                         TintA="0.17"
                                         TintR="236"
                                         TintG="239"
                                         TintB="246"
                                         ShapeRadius="0.98"
                                         ShapeRoundness="4.0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroActionButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="CornerRadius" Value="21"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background">
                <Setter.Value>
                    <lg:LiquidGlassBrush BlurAmount="3.15"
                                         BloomAmount="0.12"
                                         RefThickness="30"
                                         RefFactor="2.05"
                                         RefDispersion="4.6"
                                         GlareFactor="58"
                                         TintA="0.10"
                                         TintR="220"
                                         TintG="230"
                                         TintB="248"
                                         ShapeRadius="0.96"
                                         ShapeRoundness="3.9"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- The current Hero softly colors the page below it, matching the
             reference's poster-to-content mist instead of ending at a hard edge. -->
        <Grid x:Name="PageBackdropLayer"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <controls:CachedImage x:Name="PageBackdropImage"
                                  LazyLoadingEnabled="False"
                                  Stretch="UniformToFill"
                                  Opacity="0.30"
                                  RenderTransformOrigin="0.5,0.5">
                <controls:CachedImage.RenderTransform>
                    <ScaleTransform ScaleX="1.16"
                                    ScaleY="1.16"/>
                </controls:CachedImage.RenderTransform>
            </controls:CachedImage>
            <controls:CachedImage x:Name="PageBackdropImageAlt"
                                  LazyLoadingEnabled="False"
                                  Stretch="UniformToFill"
                                  Opacity="0"
                                  RenderTransformOrigin="0.5,0.5">
                <controls:CachedImage.RenderTransform>
                    <ScaleTransform ScaleX="1.16"
                                    ScaleY="1.16"/>
                </controls:CachedImage.RenderTransform>
            </controls:CachedImage>

            <Rectangle>
                <Rectangle.Fill>
                    <AcrylicBrush TintColor="{ThemeResource AsterHeroFadeEndColor}"
                                  TintOpacity="0.62"
                                  TintLuminosityOpacity="0.54"
                                  FallbackColor="{ThemeResource AsterHeroFadeEndColor}"/>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="0,1">
                        <GradientStop Color="#08000000" Offset="0"/>
                        <GradientStop Color="{ThemeResource AsterAmbientOverlayMidColor}" Offset="0.52"/>
                        <GradientStop Color="{ThemeResource AsterHeroFadeEndColor}" Offset="0.88"/>
                        <GradientStop Color="{ThemeResource AsterHeroFadeEndColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Reference-style fixed controls: a compact frosted server capsule
             on the left and a circular search control on the right. -->
        <Grid x:Name="FloatingTopControls"
              Margin="34,30,172,0"
              VerticalAlignment="Top"
              Canvas.ZIndex="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ServerPillButton"
                    Grid.Column="0"
                    Height="54"
                    MinWidth="174"
                    Padding="10,0,14,0"
                    CornerRadius="27"
                    BorderBrush="#72FFFFFF"
                    BorderThickness="1"
                    Template="{StaticResource FlatButtonTemplate}"
                    Click="ServerPill_Click">
                <Button.Background>
                    <lg:LiquidGlassBrush BlurAmount="4.6"
                                         BloomAmount="0.12"
                                         RefThickness="34"
                                         RefFactor="2.10"
                                         RefDispersion="4.2"
                                         DispersionRange="0.32"
                                         RefFresnelFactor="18"
                                         GlareFactor="55"
                                         TintA="0.28"
                                         TintR="238"
                                         TintG="240"
                                         TintB="246"
                                         ShapeRadius="0.99"
                                         ShapeRoundness="4.0"/>
                </Button.Background>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="18"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="34"
                            Height="34"
                            CornerRadius="9"
                            BorderBrush="#66FFFFFF"
                            BorderThickness="1"
                            Background="#42000000">
                        <FontIcon Glyph="&#xE7F8;"
                                  Foreground="White"
                                  FontSize="15"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="ServerNameBlock"
                               Grid.Column="1"
                               Margin="11,0,10,0"
                               Text="服务器"
                               Foreground="#EA101217"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="190"
                               VerticalAlignment="Center"/>

                    <FontIcon Grid.Column="2"
                              Glyph="&#xE70D;"
                              Foreground="#B8101217"
                              FontSize="11"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <Button x:Name="SearchButton"
                    Grid.Column="2"
                    Width="54"
                    Height="54"
                    Padding="0"
                    CornerRadius="27"
                    BorderBrush="#72FFFFFF"
                    BorderThickness="1"
                    Template="{StaticResource FlatButtonTemplate}"
                    Click="Search_Click">
                <Button.Background>
                    <lg:LiquidGlassBrush BlurAmount="4.6"
                                         BloomAmount="0.12"
                                         RefThickness="34"
                                         RefFactor="2.10"
                                         RefDispersion="4.2"
                                         DispersionRange="0.32"
                                         RefFresnelFactor="18"
                                         GlareFactor="55"
                                         TintA="0.28"
                                         TintR="238"
                                         TintG="240"
                                         TintB="246"
                                         ShapeRadius="0.99"
                                         ShapeRoundness="4.0"/>
                </Button.Background>
                <FontIcon Glyph="&#xE721;"
                          Foreground="#EF101217"
                          FontSize="22"/>
            </Button>
        </Grid>

        <ScrollViewer x:Name="HomeScrollViewer"
                      Visibility="Visible"
                      Opacity="0"
                      IsHitTestVisible="False"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      ZoomMode="Disabled"
                      SizeChanged="HomeScrollViewer_SizeChanged">
            <Grid Width="{Binding ElementName=HomeScrollViewer, Path=ViewportWidth}"
                  HorizontalAlignment="Stretch">
                <StackPanel x:Name="HomeContentStack"
                            HorizontalAlignment="Stretch"
                            Padding="28,0,28,130"
                            Spacing="30">

                <!-- Full-bleed poster Hero with a long mist fade into the page. -->
                <Grid x:Name="HeroContainer"
                      Height="690"
                      Margin="-28,0,-28,-86">
                    <controls:CachedImage x:Name="HeroImage"
                                          LazyLoadingEnabled="False"
                                          Stretch="UniformToFill"
                                          Opacity="1"/>
                    <controls:CachedImage x:Name="HeroImageAlt"
                                          LazyLoadingEnabled="False"
                                          Stretch="UniformToFill"
                                          Opacity="0"/>

                    <!-- Keep the top readable without making the artwork look shaded. -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="0,1">
                                <GradientStop Color="#26000000" Offset="0"/>
                                <GradientStop Color="#08000000" Offset="0.27"/>
                                <GradientStop Color="#00000000" Offset="0.48"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- The important reference detail: the artwork dissolves into a
                         bright, milky page instead of ending at a visible boundary. -->
                    <Rectangle VerticalAlignment="Bottom"
                               Height="290">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="{ThemeResource AsterHeroFadeMidColor}" Offset="0.42"/>
                                <GradientStop Color="{ThemeResource AsterHeroFadeEndColor}" Offset="0.92"/>
                                <GradientStop Color="{ThemeResource AsterHeroFadeEndColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <StackPanel VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="56,0,56,132"
                                MaxWidth="820"
                                Spacing="9">
                        <TextBlock x:Name="WelcomeBlock"
                                   Visibility="Collapsed"/>

                        <TextBlock x:Name="HeroTitleBlock"
                                   Text="AsterPlay"
                                   Foreground="White"
                                   FontSize="44"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="HeroMetaBlock"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="HeroOverviewBlock"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                   FontSize="15"
                                   LineHeight="23"
                                   MaxWidth="760"
                                   MaxHeight="52"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="9"
                                    Margin="0,3,0,0">
                            <Border x:Name="HeroCommunityRatingBadge"
                                    Padding="8,4"
                                    CornerRadius="10"
                                    Background="#CCF4C430">
                                <TextBlock x:Name="HeroCommunityRatingBlock"
                                           Foreground="#E6141418"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="HeroCriticRatingBadge"
                                    Padding="8,4"
                                    CornerRadius="10"
                                    Background="#CBCD63D9">
                                <TextBlock x:Name="HeroCriticRatingBlock"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="HeroOfficialRatingBadge"
                                    Padding="8,4"
                                    CornerRadius="10"
                                    Background="#B965C9C0">
                                <TextBlock x:Name="HeroOfficialRatingBlock"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- Keep the existing command controls alive for keyboard/accessibility,
                             but the reference home surface is information-first. -->
                        <StackPanel Visibility="Collapsed">
                            <Button x:Name="HeroPlayButton"
                                    Style="{StaticResource HeroActionButtonStyle}"
                                    Content="▶  播放"
                                    Click="HeroPlay_Click"/>
                            <Button Style="{StaticResource HeroActionButtonStyle}"
                                    Content="详情"
                                    Click="HeroDetails_Click"/>
                            <Button x:Name="HeroFavoriteButton"
                                    Style="{StaticResource HeroActionButtonStyle}"
                                    Content="♡  收藏"
                                    Click="HeroFavorite_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="HeroIndicatorPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,96"
                                Spacing="7"
                                IsHitTestVisible="False"/>
                </Grid>

                <!-- Continue watching -->
                <StackPanel x:Name="ContinueSection"
                            Visibility="Collapsed"
                            Spacing="16">
                    <Grid>
                        <TextBlock Text="继续播放"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="7">
                            <Button x:Name="ResumePreviousButton"
                                    Style="{StaticResource RoundActionButtonStyle}"
                                    Content="‹"
                                    Tag="-1"
                                    Click="ResumeArrow_Click"/>
                            <Button x:Name="ResumeNextButton"
                                    Style="{StaticResource RoundActionButtonStyle}"
                                    Content="›"
                                    Tag="1"
                                    Click="ResumeArrow_Click"/>
                            <Button Content="更多  ›"
                                    Style="{StaticResource SectionMoreButtonStyle}"
                                    Click="OpenLibrary_Click"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="ResumeScroller"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  ZoomMode="Disabled"
                                  ViewChanged="ResumeScroller_ViewChanged"
                                  SizeChanged="ResumeScroller_SizeChanged">
                        <ItemsControl x:Name="ResumeGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="320"
                                            Margin="0,0,18,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{Binding}"
                                            RenderTransformOrigin="0.5,0.5"
                                            PointerEntered="MediaCard_PointerEntered"
                                            PointerExited="MediaCard_PointerExited"
                                            Click="ResumeTile_Click"
                                            RightTapped="ResumeTile_RightTapped"
                                            Template="{StaticResource FlatButtonTemplate}">
                                        <Button.RenderTransform>
                                            <ScaleTransform ScaleX="1"
                                                            ScaleY="1"/>
                                        </Button.RenderTransform>
                                        <StackPanel Width="320"
                                                    Spacing="9">
                                            <Border Width="320"
                                                    Height="180"
                                                    CornerRadius="18"
                                                    Background="{ThemeResource AsterCardBackgroundBrush}"
                                                    BorderBrush="{ThemeResource AsterCardBorderBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <controls:CachedImage SourceUrl="{Binding BackdropUrl}"
                                                                          Stretch="UniformToFill"/>
                                                    <Rectangle>
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0"
                                                                                 EndPoint="0,1">
                                                                <GradientStop Color="#00000000" Offset="0.42"/>
                                                                <GradientStop Color="#B0000000" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,12,12,0"
                                                            Padding="8,4"
                                                            CornerRadius="10"
                                                            Background="#66000000">
                                                        <TextBlock Text="{Binding LastPlayedText}"
                                                                   Foreground="White"
                                                                   FontSize="11"/>
                                                    </Border>

                                                    <Grid VerticalAlignment="Bottom"
                                                          Margin="16,0,16,13">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="▶"
                                                                   Foreground="White"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                        <ProgressBar Grid.Column="2"
                                                                     Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding PlayedPercentage}"
                                                                     Height="4"
                                                                     VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding ShortProgressText}"
                                                                   Foreground="White"
                                                                   FontSize="12"
                                                                   Margin="11,0,0,0"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{Binding ResumeTitle}"
                                                       Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="{Binding EpisodeText}"
                                                       Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                       FontSize="12"
                                                       LineHeight="17"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2"
                                                       MinHeight="34"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- My media -->
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <TextBlock Text="我的媒体"
                                       Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <FontIcon Glyph="&#xE8B7;"
                                      Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                      FontSize="17"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="18"
                                    Style="{StaticResource SectionMoreButtonStyle}"
                                    Click="OpenLibrary_Click">
                                <FontIcon Glyph="&#xE8A9;" FontSize="15"/>
                            </Button>
                            <Button Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="18"
                                    Style="{StaticResource SectionMoreButtonStyle}"
                                    Click="OpenLibrary_Click">
                                <FontIcon Glyph="&#xF0E2;" FontSize="15"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsRepeater x:Name="LibrariesGrid">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="286"
                                               MinItemHeight="154"
                                               MinColumnSpacing="16"
                                               MinRowSpacing="16"
                                               ItemsJustification="Start"
                                               ItemsStretch="None"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Button Width="286"
                                        Height="154"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        Tag="{Binding}"
                                        RenderTransformOrigin="0.5,0.5"
                                        PointerEntered="MediaCard_PointerEntered"
                                        PointerExited="MediaCard_PointerExited"
                                        Click="LibraryTile_Click"
                                            Template="{StaticResource FlatButtonTemplate}">
                                    <Button.RenderTransform>
                                        <ScaleTransform ScaleX="1"
                                                        ScaleY="1"/>
                                    </Button.RenderTransform>
                                    <Border CornerRadius="20"
                                            Background="{ThemeResource AsterCardBackgroundBrush}"
                                            BorderBrush="{ThemeResource AsterCardBorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <controls:CachedImage SourceUrl="{Binding BackdropUrl}"
                                                                  Stretch="UniformToFill"
                                                                  Opacity="0.88"/>
                                            <Border BorderBrush="#24FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="20"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Library sections -->
                <ItemsControl x:Name="LibrarySectionsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="16"
                                        Margin="0,0,0,30">
                                <Grid>
                                    <StackPanel Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CountLabel}"
                                                   Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                   FontSize="12"
                                                   Opacity="0.82"/>
                                    </StackPanel>

                                    <Button Content="更多  ›"
                                            Style="{StaticResource SectionMoreButtonStyle}"
                                            HorizontalAlignment="Right"
                                            Tag="{Binding}"
                                            Click="LibrarySectionMore_Click"/>
                                </Grid>

                                <ItemsRepeater ItemsSource="{Binding Items}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="158"
                                                           MinItemHeight="278"
                                                           MinColumnSpacing="16"
                                                           MinRowSpacing="20"
                                                           ItemsJustification="Start"
                                                           ItemsStretch="None"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Button MinWidth="158"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    Tag="{Binding}"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    PointerEntered="MediaCard_PointerEntered"
                                                    PointerExited="MediaCard_PointerExited"
                                                    Click="SectionMedia_Click"
                                            Template="{StaticResource FlatButtonTemplate}">
                                                <Button.RenderTransform>
                                                    <ScaleTransform ScaleX="1"
                                                                    ScaleY="1"/>
                                                </Button.RenderTransform>
                                                <StackPanel Spacing="8">
                                                    <Border Height="232"
                                                            CornerRadius="18"
                                                            Background="{ThemeResource AsterCardBackgroundBrush}"
                                                            BorderBrush="{ThemeResource AsterCardBorderBrush}"
                                                            BorderThickness="1">
                                                        <controls:CachedImage SourceUrl="{Binding PosterUrl}"
                                                                              Stretch="UniformToFill"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               LineHeight="18"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="2"
                                                               MinHeight="36"/>
                                                    <TextBlock Text="{Binding Meta}"
                                                               Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid x:Name="NoServerState"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14"
                        Margin="24">
                <Border Width="86"
                        Height="86"
                        CornerRadius="30"
                        Background="{ThemeResource AsterCardBackgroundBrush}"
                        BorderBrush="{ThemeResource AsterCardBorderBrush}"
                        BorderThickness="1">
                    <FontIcon Glyph="&#xE7F8;"
                              FontSize="36"
                              Foreground="{ThemeResource AsterSecondaryTextBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="暂无服务器"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AsterPrimaryTextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="请先添加服务器"
                           FontSize="15"
                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
                <Button Content="前往服务器页面"
                        Margin="0,10,0,0"
                        Padding="24,11"
                        CornerRadius="18"
                        HorizontalAlignment="Center"
                        Click="GoToServers_Click"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="LoadingState"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                <ProgressRing x:Name="LoadingRing"
                              Width="38"
                              Height="38"
                              IsActive="False"/>
                <TextBlock x:Name="LoadingTextBlock"
                           Text="正在加载"
                           FontSize="15"
                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
