<UserControl
    x:Class="AsterPlay.WinUI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AsterPlay.WinUI.Controls"
    xmlns:lg="using:LiquidGlassWinUI">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                         Color="#14000000"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                         Color="#22000000"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                         Color="#44FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                         Color="#55FFFFFF"/>

        <!-- Flat hover treatment: preserve the supplied background/glass exactly,
             and use only a restrained scale response for pointer/press feedback. -->
        <ControlTemplate x:Key="FlatButtonTemplate"
                         TargetType="Button">
            <Border x:Name="ButtonVisualRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ButtonScaleTransform"
                                    ScaleX="1"
                                    ScaleY="1"/>
                </Border.RenderTransform>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1"
                                                 Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1"
                                                 Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </VisualState>

                        <VisualState x:Name="PointerOver">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.04"
                                                 Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.04"
                                                 Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </VisualState>

                        <VisualState x:Name="Pressed">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="0.97"
                                                 Duration="0:0:0.07">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="0.97"
                                                 Duration="0:0:0.07">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </VisualState>

                        <VisualState x:Name="Disabled">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1"
                                                 Duration="0"/>
                                <DoubleAnimation Storyboard.TargetName="ButtonScaleTransform"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1"
                                                 Duration="0"/>
                                <DoubleAnimation Storyboard.TargetName="ButtonVisualRoot"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0.45"
                                                 Duration="0:0:0.14"/>
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="RoundActionButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Foreground" Value="{ThemeResource AsterRailArrowForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AsterRailArrowBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background">
                <Setter.Value>
                    <lg:LiquidGlassBrush BlurAmount="1.15"
                                         BloomAmount="0.04"
                                         RefThickness="18"
                                         RefFactor="1.95"
                                         RefDispersion="3.0"
                                         DispersionRange="0.38"
                                         RefFresnelFactor="18"
                                         GlareFactor="42"
                                         TintA="0.08"
                                         TintR="205"
                                         TintG="225"
                                         TintB="255"
                                         ShapeRadius="0.99"
                                         ShapeRoundness="4.0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionMoreButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#34FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{ThemeResource AsterPrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background">
                <Setter.Value>
                    <lg:LiquidGlassBrush BlurAmount="1.20"
                                         BloomAmount="0.05"
                                         RefThickness="18"
                                         RefFactor="1.85"
                                         RefDispersion="2.6"
                                         DispersionRange="0.34"
                                         RefFresnelFactor="18"
                                         GlareFactor="42"
                                         TintA="0.12"
                                         TintR="236"
                                         TintG="239"
                                         TintB="246"
                                         ShapeRadius="0.99"
                                         ShapeRoundness="4.0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroActionButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="CornerRadius" Value="21"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background">
                <Setter.Value>
                    <lg:LiquidGlassBrush BlurAmount="1.20"
                                         BloomAmount="0.05"
                                         RefThickness="20"
                                         RefFactor="1.90"
                                         RefDispersion="2.8"
                                         DispersionRange="0.36"
                                         RefFresnelFactor="20"
                                         GlareFactor="48"
                                         TintA="0.10"
                                         TintR="220"
                                         TintG="230"
                                         TintB="248"
                                         ShapeRadius="0.99"
                                         ShapeRoundness="4.0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource AsterPageBackgroundBrush}">
        <!-- Reference-style fixed controls: a compact frosted server capsule
             on the left and a circular search control on the right. -->
        <Grid x:Name="FloatingTopControls"
              Margin="34,58,34,0"
              VerticalAlignment="Top"
              Canvas.ZIndex="100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ServerPillButton"
                    Grid.Column="0"
                    Height="54"
                    MinWidth="174"
                    Padding="10,0,14,0"
                    CornerRadius="27"
                    BorderBrush="#72FFFFFF"
                    BorderThickness="1"
                    Template="{StaticResource FlatButtonTemplate}"
                    Click="ServerPill_Click">
                <Button.Background>
                    <lg:LiquidGlassBrush BlurAmount="1.45"
                                         BloomAmount="0.06"
                                         RefThickness="24"
                                         RefFactor="2.05"
                                         RefDispersion="3.2"
                                         DispersionRange="0.38"
                                         RefFresnelFactor="21"
                                         GlareFactor="52"
                                         TintA="0.16"
                                         TintR="238"
                                         TintG="240"
                                         TintB="246"
                                         ShapeRadius="0.99"
                                         ShapeRoundness="4.0"/>
                </Button.Background>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="34"
                            Height="34"
                            CornerRadius="9"
                            BorderBrush="#66FFFFFF"
                            BorderThickness="1"
                            Background="#2C000000">
                        <Grid>
                            <FontIcon Glyph="&#xE77B;"
                                      Foreground="#F5FFFFFF"
                                      FontSize="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            <controls:CachedImage x:Name="CurrentUserAvatarImage"
                                                  LazyLoadingEnabled="False"
                                                  Stretch="UniformToFill"
                                                  CornerRadius="9"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ServerNameBlock"
                               Grid.Column="1"
                               Margin="11,0,4,0"
                               Text="服务器"
                               Foreground="#FF101217"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="190"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <Button x:Name="SearchButton"
                    Grid.Column="2"
                    Width="54"
                    Height="54"
                    Padding="0"
                    CornerRadius="27"
                    BorderBrush="#72FFFFFF"
                    BorderThickness="1"
                    Template="{StaticResource FlatButtonTemplate}"
                    Click="Search_Click">
                <Button.Background>
                    <lg:LiquidGlassBrush BlurAmount="1.45"
                                         BloomAmount="0.06"
                                         RefThickness="24"
                                         RefFactor="2.05"
                                         RefDispersion="3.2"
                                         DispersionRange="0.38"
                                         RefFresnelFactor="21"
                                         GlareFactor="52"
                                         TintA="0.16"
                                         TintR="238"
                                         TintG="240"
                                         TintB="246"
                                         ShapeRadius="0.99"
                                         ShapeRoundness="4.0"/>
                </Button.Background>
                <FontIcon Glyph="&#xE721;"
                          Foreground="#FF101217"
                          FontSize="22"/>
            </Button>
        </Grid>

        <Grid x:Name="ServerChooserDismissLayer"
              Background="#01000000"
              Visibility="Collapsed"
              Tapped="ServerChooserDismiss_Tapped"
              Canvas.ZIndex="85"/>

        <!-- Compact liquid-glass chooser. It appears from the server capsule
             with a short fade/scale/slide transition instead of popping in. -->
        <Border x:Name="ServerChooserPanel"
                Width="310"
                MaxHeight="340"
                Margin="34,122,0,0"
                Padding="12,8"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="28"
                BorderBrush="#82FFFFFF"
                BorderThickness="1"
                Opacity="0"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0"
                Canvas.ZIndex="90">
            <Border.RenderTransform>
                <CompositeTransform x:Name="ServerChooserTransform"
                                    ScaleX="0.96"
                                    ScaleY="0.96"
                                    TranslateY="-8"/>
            </Border.RenderTransform>
            <Border.Background>
                <lg:LiquidGlassBrush BlurAmount="1.65"
                                     BloomAmount="0.08"
                                     RefThickness="28"
                                     RefFactor="1.80"
                                     RefDispersion="2.4"
                                     DispersionRange="0.28"
                                     RefFresnelFactor="18"
                                     GlareFactor="38"
                                     TintA="0.20"
                                     TintR="239"
                                     TintG="242"
                                     TintB="247"
                                     ShapeRadius="0.18"
                                     ShapeRoundness="4.0"/>
            </Border.Background>

            <ScrollViewer VerticalScrollMode="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          ZoomMode="Disabled">
                <ItemsControl x:Name="ServerChooserList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#22000000"
                                BorderThickness="0,0,0,1">
                            <Button Height="62"
                                    Padding="10,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="22"
                                    HorizontalContentAlignment="Stretch"
                                    Template="{StaticResource FlatButtonTemplate}"
                                    Tag="{Binding Profile}"
                                    Click="ServerChoice_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="32"
                                            Height="32"
                                            CornerRadius="9"
                                            Background="#2B000000"
                                            BorderBrush="#5CFFFFFF"
                                            BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F8;"
                                                  Foreground="#F5FFFFFF"
                                                  FontSize="14"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,6,0"
                                               Text="{Binding DisplayName}"
                                               Foreground="#FF15171C"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding CurrentMark}"
                                               Foreground="#FF15171C"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Border>
                    </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <ScrollViewer x:Name="HomeScrollViewer"
                      Visibility="Visible"
                      Opacity="0"
                      IsHitTestVisible="False"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      ZoomMode="Disabled"
                      ViewChanged="HomeScrollViewer_ViewChanged"
                      SizeChanged="HomeScrollViewer_SizeChanged">
            <Grid Width="{Binding ElementName=HomeScrollViewer, Path=ViewportWidth}"
                  HorizontalAlignment="Stretch">

                <StackPanel x:Name="HomeContentStack"
                            HorizontalAlignment="Stretch"
                            Padding="28,0,28,130"
                            Spacing="30">

                <!-- Full-bleed Hero. The image stays completely sharp; only one
                     continuous theme-aware fade blends its lower edge into the page. -->
                <Grid x:Name="HeroContainer"
                      Height="690"
                      Margin="-28,0,-28,-112">
                    <!-- The carousel keeps its original Hero geometry and remains
                         completely unblurred. The fade overlay below does not change
                         artwork framing or image sharpness. -->
                    <controls:CachedImage x:Name="HeroImage"
                                          LazyLoadingEnabled="False"
                                          Stretch="UniformToFill"
                                          Opacity="1"/>
                    <controls:CachedImage x:Name="HeroImageAlt"
                                          LazyLoadingEnabled="False"
                                          Stretch="UniformToFill"
                                          Opacity="0"/>

                    <!-- One uninterrupted fade: transparent over the Hero, then
                         smoothly into the real light/dark page background. No blur,
                         duplicated image, stacked bands or hard transition boundary. -->
                    <Rectangle VerticalAlignment="Bottom"
                               Height="430"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="{ThemeResource AsterAmbientOverlayTopColor}" Offset="0.38"/>
                                <GradientStop Color="{ThemeResource AsterHeroFadeMidColor}" Offset="0.72"/>
                                <GradientStop Color="{ThemeResource AsterHeroFadeEndColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <StackPanel VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="56,0,56,132"
                                MaxWidth="820"
                                Spacing="9">
                        <TextBlock x:Name="WelcomeBlock"
                                   Visibility="Collapsed"/>

                        <TextBlock x:Name="HeroTitleBlock"
                                   Text="AsterPlay"
                                   Foreground="White"
                                   FontSize="44"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="HeroMetaBlock"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="HeroOverviewBlock"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                   FontSize="15"
                                   LineHeight="23"
                                   MaxWidth="760"
                                   MaxHeight="52"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="9"
                                    Margin="0,3,0,0">
                            <Border x:Name="HeroCommunityRatingBadge"
                                    Padding="8,4"
                                    CornerRadius="10"
                                    Background="#CCF4C430">
                                <TextBlock x:Name="HeroCommunityRatingBlock"
                                           Foreground="#E6141418"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="HeroCriticRatingBadge"
                                    Padding="8,4"
                                    CornerRadius="10"
                                    Background="#CBCD63D9">
                                <TextBlock x:Name="HeroCriticRatingBlock"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <Border x:Name="HeroOfficialRatingBadge"
                                    Padding="8,4"
                                    CornerRadius="10"
                                    Background="#B965C9C0">
                                <TextBlock x:Name="HeroOfficialRatingBlock"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- Keep the existing command controls alive for keyboard/accessibility,
                             but the reference home surface is information-first. -->
                        <StackPanel Visibility="Collapsed">
                            <Button x:Name="HeroPlayButton"
                                    Style="{StaticResource HeroActionButtonStyle}"
                                    Content="▶  播放"
                                    Click="HeroPlay_Click"/>
                            <Button Style="{StaticResource HeroActionButtonStyle}"
                                    Content="详情"
                                    Click="HeroDetails_Click"/>
                            <Button x:Name="HeroFavoriteButton"
                                    Style="{StaticResource HeroActionButtonStyle}"
                                    Content="♡  收藏"
                                    Click="HeroFavorite_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="HeroIndicatorPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,112"
                                Spacing="7"
                                IsHitTestVisible="False"/>
                </Grid>

                <!-- Continue watching -->
                <StackPanel x:Name="ContinueSection"
                            Visibility="Collapsed"
                            Spacing="16">
                    <Grid>
                        <TextBlock Text="继续播放"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="7">
                            <Button x:Name="ResumePreviousButton"
                                    Style="{StaticResource RoundActionButtonStyle}"
                                    Content="‹"
                                    Tag="-1"
                                    Click="ResumeArrow_Click"/>
                            <Button x:Name="ResumeNextButton"
                                    Style="{StaticResource RoundActionButtonStyle}"
                                    Content="›"
                                    Tag="1"
                                    Click="ResumeArrow_Click"/>
                            <Button Content="更多  ›"
                                    Style="{StaticResource SectionMoreButtonStyle}"
                                    Click="OpenLibrary_Click"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="ResumeScroller"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  ZoomMode="Disabled"
                                  ViewChanged="ResumeScroller_ViewChanged"
                                  SizeChanged="ResumeScroller_SizeChanged">
                        <ItemsControl x:Name="ResumeGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="320"
                                            Margin="0,0,18,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{Binding}"
                                            Click="ResumeTile_Click"
                                            RightTapped="ResumeTile_RightTapped"
                                            Template="{StaticResource FlatButtonTemplate}">
                                        <StackPanel Width="320"
                                                    Spacing="9">
                                            <Border Width="320"
                                                    Height="180"
                                                    CornerRadius="18"
                                                    Background="{ThemeResource AsterCardBackgroundBrush}"
                                                    BorderBrush="{ThemeResource AsterCardBorderBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <controls:CachedImage SourceUrl="{Binding BackdropUrl}"
                                                                          Stretch="UniformToFill"
                                                                          CornerRadius="18"/>
                                                    <Border CornerRadius="18"
                                                            IsHitTestVisible="False">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0"
                                                                                 EndPoint="0,1">
                                                                <GradientStop Color="#00000000" Offset="0.42"/>
                                                                <GradientStop Color="#B0000000" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,12,12,0"
                                                            Padding="8,4"
                                                            CornerRadius="10"
                                                            Background="#66000000">
                                                        <TextBlock Text="{Binding LastPlayedText}"
                                                                   Foreground="White"
                                                                   FontSize="11"/>
                                                    </Border>

                                                    <Grid VerticalAlignment="Bottom"
                                                          Margin="16,0,16,13">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="▶"
                                                                   Foreground="White"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                        <ProgressBar Grid.Column="2"
                                                                     Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding PlayedPercentage}"
                                                                     Height="4"
                                                                     VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding ShortProgressText}"
                                                                   Foreground="White"
                                                                   FontSize="12"
                                                                   Margin="11,0,0,0"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{Binding ResumeTitle}"
                                                       Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="{Binding EpisodeText}"
                                                       Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                       FontSize="12"
                                                       LineHeight="17"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2"
                                                       MinHeight="34"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- My media -->
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <TextBlock Text="我的媒体"
                                       Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                       FontSize="27"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <FontIcon Glyph="&#xE8B7;"
                                      Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                      FontSize="17"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="7">
                            <Button x:Name="LibrariesPreviousButton"
                                    Style="{StaticResource RoundActionButtonStyle}"
                                    Content="‹"
                                    Tag="-1"
                                    Click="LibrariesArrow_Click"/>
                            <Button x:Name="LibrariesNextButton"
                                    Style="{StaticResource RoundActionButtonStyle}"
                                    Content="›"
                                    Tag="1"
                                    Click="LibrariesArrow_Click"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="LibrariesScroller"
                                  HorizontalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  ZoomMode="Disabled"
                                  ViewChanged="LibrariesScroller_ViewChanged"
                                  SizeChanged="LibrariesScroller_SizeChanged">
                        <ItemsRepeater x:Name="LibrariesGrid">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal"
                                             Spacing="16"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="286"
                                            Height="154"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Stretch"
                                            Tag="{Binding}"
                                            Click="LibraryTile_Click"
                                            Template="{StaticResource FlatButtonTemplate}">
                                        <Border CornerRadius="20"
                                                Background="{ThemeResource AsterCardBackgroundBrush}"
                                                BorderBrush="{ThemeResource AsterCardBorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <controls:CachedImage SourceUrl="{Binding BackdropUrl}"
                                                                      Stretch="UniformToFill"
                                                                      CornerRadius="20"
                                                                      Opacity="0.88"/>
                                                <Border BorderBrush="#24FFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="20"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <!-- Library sections -->
                <ItemsControl x:Name="LibrarySectionsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="16"
                                        Margin="0,0,0,30">
                                <Grid>
                                    <StackPanel Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CountLabel}"
                                                   Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                   FontSize="12"
                                                   Opacity="0.82"/>
                                    </StackPanel>

                                    <Button Content="更多  ›"
                                            Style="{StaticResource SectionMoreButtonStyle}"
                                            HorizontalAlignment="Right"
                                            Tag="{Binding}"
                                            Click="LibrarySectionMore_Click"/>
                                </Grid>

                                <!-- Every media row is a single horizontal rail. -->
                                <ScrollViewer Visibility="{Binding PosterVisibility}"
                                              HorizontalScrollMode="Enabled"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollMode="Disabled"
                                              VerticalScrollBarVisibility="Disabled"
                                              ZoomMode="Disabled">
                                    <ItemsRepeater ItemsSource="{Binding Items}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal"
                                                         Spacing="16"/>
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="158"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        HorizontalAlignment="Stretch"
                                                        Tag="{Binding}"
                                                        Click="SectionMedia_Click"
                                                        Template="{StaticResource FlatButtonTemplate}">
                                                    <StackPanel Width="158"
                                                                Spacing="8">
                                                        <Border Width="158"
                                                                Height="232"
                                                                CornerRadius="18"
                                                                Background="{ThemeResource AsterCardBackgroundBrush}"
                                                                BorderBrush="{ThemeResource AsterCardBorderBrush}"
                                                                BorderThickness="1">
                                                            <controls:CachedImage SourceUrl="{Binding PosterUrl}"
                                                                                  Stretch="UniformToFill"
                                                                                  CornerRadius="18"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   LineHeight="18"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxLines="2"
                                                                   MinHeight="36"/>
                                                        <TextBlock Text="{Binding Meta}"
                                                                   Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>

                                <!-- TV libraries use the same single-row horizontal rail rule. -->
                                <ScrollViewer Visibility="{Binding SeriesVisibility}"
                                              HorizontalScrollMode="Enabled"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollMode="Disabled"
                                              VerticalScrollBarVisibility="Disabled"
                                              ZoomMode="Disabled">
                                    <ItemsRepeater ItemsSource="{Binding Items}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal"
                                                         Spacing="18"/>
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="300"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        HorizontalAlignment="Stretch"
                                                        Tag="{Binding}"
                                                        Click="SectionMedia_Click"
                                                        Template="{StaticResource FlatButtonTemplate}">
                                                    <StackPanel Width="300"
                                                                Spacing="9">
                                                        <Border Width="300"
                                                                Height="169"
                                                                CornerRadius="18"
                                                                Background="{ThemeResource AsterCardBackgroundBrush}"
                                                                BorderBrush="{ThemeResource AsterCardBorderBrush}"
                                                                BorderThickness="1">
                                                            <Grid>
                                                                <controls:CachedImage SourceUrl="{Binding BackdropUrl}"
                                                                                      Stretch="UniformToFill"
                                                                                      CornerRadius="18"/>
                                                                <Border CornerRadius="18"
                                                                        IsHitTestVisible="False">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0"
                                                                                             EndPoint="0,1">
                                                                            <GradientStop Color="#00000000" Offset="0.58"/>
                                                                            <GradientStop Color="#24000000" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <Border BorderBrush="#24FFFFFF"
                                                                        BorderThickness="1"
                                                                        CornerRadius="18"/>
                                                            </Grid>
                                                        </Border>

                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <TextBlock Text="{Binding Meta}"
                                                                   Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid x:Name="NoServerState"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14"
                        Margin="24">
                <Border Width="86"
                        Height="86"
                        CornerRadius="30"
                        Background="{ThemeResource AsterCardBackgroundBrush}"
                        BorderBrush="{ThemeResource AsterCardBorderBrush}"
                        BorderThickness="1">
                    <FontIcon Glyph="&#xE7F8;"
                              FontSize="36"
                              Foreground="{ThemeResource AsterSecondaryTextBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="暂无服务器"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AsterPrimaryTextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="请先添加服务器"
                           FontSize="15"
                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
                <Button Content="前往服务器页面"
                        Margin="0,10,0,0"
                        Padding="24,11"
                        CornerRadius="18"
                        HorizontalAlignment="Center"
                        Click="GoToServers_Click"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="LoadingState"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                <ProgressRing x:Name="LoadingRing"
                              Width="38"
                              Height="38"
                              IsActive="False"/>
                <TextBlock x:Name="LoadingTextBlock"
                           Text="正在加载"
                           FontSize="15"
                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
