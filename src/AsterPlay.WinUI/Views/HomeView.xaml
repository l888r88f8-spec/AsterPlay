<UserControl
    x:Class="AsterPlay.WinUI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lg="using:LiquidGlassWinUI">

    <Grid>
        <ScrollViewer x:Name="HomeScrollViewer"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      ZoomMode="Disabled">
            <StackPanel Padding="48,24,48,136"
                        Spacing="28">
                <Grid Height="330">
                    <Border CornerRadius="32">
                        <Border.Background>
                            <lg:LiquidGlassBrush BlurAmount="1.5"
                                                 BloomAmount="0.12"
                                                 RefThickness="42"
                                                 RefFactor="2.1"
                                                 RefDispersion="4.5"
                                                 GlareFactor="58"
                                                 TintA="0.06"
                                                 ShapeRadius="0.82"
                                                 ShapeRoundness="3.8"/>
                        </Border.Background>

                        <Grid>
                            <Image x:Name="HeroImage"
                                   Stretch="UniformToFill"
                                   Opacity="0.52"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5"
                                                         EndPoint="1,0.5">
                                        <GradientStop Color="#E3080A0F" Offset="0"/>
                                        <GradientStop Color="#A5080A0F" Offset="0.42"/>
                                        <GradientStop Color="#26080A0F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel VerticalAlignment="Bottom"
                                        Margin="36"
                                        MaxWidth="700"
                                        HorizontalAlignment="Left"
                                        Spacing="10">
                                <TextBlock x:Name="WelcomeBlock"
                                           Foreground="#79BCFF"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="HeroTitleBlock"
                                           Text="AsterPlay"
                                           Foreground="White"
                                           FontSize="46"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="HeroMetaBlock"
                                           Foreground="#CBD2DD"
                                           FontSize="14"/>
                                <TextBlock x:Name="HeroOverviewBlock"
                                           Foreground="#AAB3C1"
                                           FontSize="14"
                                           LineHeight="22"
                                           MaxWidth="640"
                                           MaxHeight="68"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="媒体库"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                        <Button Content="查看全部"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#79BCFF"
                                Click="OpenLibrary_Click"/>
                    </Grid>

                    <ScrollViewer x:Name="LibrariesScroller"
                                  HorizontalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  ZoomMode="Disabled"
                                  PointerWheelChanged="HorizontalRail_PointerWheelChanged">
                        <ItemsControl x:Name="LibrariesGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="220"
                                            Height="92"
                                            Margin="0,0,12,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{Binding}"
                                            Click="LibraryTile_Click">
                                        <Border Width="220"
                                                Height="92"
                                                Padding="18"
                                                CornerRadius="22">
                                            <Border.Background>
                                                <lg:LiquidGlassBrush BlurAmount="1.3"
                                                                     BloomAmount="0.13"
                                                                     RefThickness="26"
                                                                     RefFactor="1.8"
                                                                     RefDispersion="3.5"
                                                                     GlareFactor="48"
                                                                     TintA="0.07"
                                                                     ShapeRadius="0.88"
                                                                     ShapeRoundness="3.8"/>
                                            </Border.Background>
                                            <StackPanel VerticalAlignment="Center" Spacing="5">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="White"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Foreground="#909AA9"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="ContinueSection"
                            Spacing="14"
                            Visibility="Collapsed">
                    <TextBlock Text="继续播放"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"/>

                    <ScrollViewer x:Name="ResumeScroller"
                                  HorizontalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  ZoomMode="Disabled"
                                  PointerWheelChanged="HorizontalRail_PointerWheelChanged">
                        <ItemsControl x:Name="ResumeGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="270"
                                            Margin="0,0,14,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{Binding}"
                                            Click="ResumeTile_Click">
                                        <StackPanel Width="270"
                                                    Spacing="8">
                                            <Border Width="270"
                                                    Height="152"
                                                    CornerRadius="18"
                                                    Background="#171C26"
                                                    BorderBrush="#32FFFFFF"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding BackdropUrl}"
                                                           Stretch="UniformToFill"/>
                                                    <Rectangle>
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0"
                                                                                 EndPoint="0,1">
                                                                <GradientStop Color="#00000000" Offset="0.48"/>
                                                                <GradientStop Color="#B8000000" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <StackPanel VerticalAlignment="Bottom"
                                                                Margin="12,0,12,10"
                                                                Spacing="6">
                                                        <ProgressBar Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding PlayedPercentage}"
                                                                     Height="3"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{Binding ResumeTitle}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ProgressText}"
                                                       Foreground="#8993A3"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="最新媒体"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="最近加入"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#6F7B8D"
                                   FontSize="12"/>
                    </Grid>

                    <ScrollViewer x:Name="LatestScroller"
                                  HorizontalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  ZoomMode="Disabled"
                                  PointerWheelChanged="HorizontalRail_PointerWheelChanged">
                        <ItemsControl x:Name="LatestGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="164"
                                            Margin="0,0,14,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{Binding}"
                                            Click="LatestTile_Click">
                                        <StackPanel Width="164"
                                                    Spacing="8">
                                            <Border Width="164"
                                                    Height="238"
                                                    CornerRadius="18"
                                                    Background="#171C26"
                                                    BorderBrush="#32FFFFFF"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding PosterUrl}"
                                                           Stretch="UniformToFill"/>
                                                    <Rectangle VerticalAlignment="Bottom"
                                                               Height="56">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0"
                                                                                 EndPoint="0,1">
                                                                <GradientStop Color="#00000000" Offset="0"/>
                                                                <GradientStop Color="#72000000" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Meta}"
                                                       Foreground="#8792A2"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingRing"
                      Width="38"
                      Height="38"
                      IsActive="True"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
    </Grid>
</UserControl>
