<UserControl
    x:Class="AsterPlay.WinUI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lg="using:LiquidGlassWinUI"
    xmlns:controls="using:AsterPlay.WinUI.Controls">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                         Color="#14000000"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                         Color="#22000000"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                         Color="#44FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                         Color="#55FFFFFF"/>
        <Style x:Key="RoundActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Foreground" Value="{ThemeResource AsterRailArrowForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AsterRailArrowBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background">
                <Setter.Value>
                    <lg:LiquidGlassBrush BlurAmount="1.25"
                                         BloomAmount="0.10"
                                         RefThickness="20"
                                         RefFactor="1.75"
                                         RefDispersion="3.2"
                                         GlareFactor="48"
                                         TintA="0.08"
                                         TintR="205"
                                         TintG="225"
                                         TintB="255"
                                         ShapeRadius="0.98"
                                         ShapeRoundness="3.9"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionMoreButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{ThemeResource AsterSecondaryTextBrush}"/>
            <Setter Property="Background" Value="{ThemeResource AsterCardBackgroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="HeroActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="CornerRadius" Value="21"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#3811151D"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- The Hero artwork becomes the fixed ambience for the whole page. -->
        <Grid x:Name="PageBackdropLayer"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <controls:CachedImage x:Name="PageBackdropImage"
                                  LazyLoadingEnabled="False"
                                  Stretch="UniformToFill"
                                  Opacity="0.84"
                                  RenderTransformOrigin="0.5,0.5">
                <controls:CachedImage.RenderTransform>
                    <ScaleTransform ScaleX="1.12"
                                    ScaleY="1.12"/>
                </controls:CachedImage.RenderTransform>
            </controls:CachedImage>

            <Rectangle>
                <Rectangle.Fill>
                    <AcrylicBrush TintColor="{ThemeResource AsterHeroFadeEndColor}"
                                  TintOpacity="0.14"
                                  TintLuminosityOpacity="0.26"
                                  FallbackColor="{ThemeResource AsterHeroFadeEndColor}"/>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle Opacity="0.68">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="0,1">
                        <GradientStop Color="{ThemeResource AsterAmbientOverlayTopColor}"
                                      Offset="0"/>
                        <GradientStop Color="{ThemeResource AsterAmbientOverlayMidColor}"
                                      Offset="0.58"/>
                        <GradientStop Color="{ThemeResource AsterAmbientOverlayBottomColor}"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <ScrollViewer x:Name="HomeScrollViewer"
                      Visibility="Visible"
                      Opacity="0"
                      IsHitTestVisible="False"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      ZoomMode="Disabled"
                      SizeChanged="HomeScrollViewer_SizeChanged">
            <StackPanel x:Name="HomeContentStack"
                        Width="{Binding ElementName=HomeScrollViewer, Path=ViewportWidth}"
                        HorizontalAlignment="Stretch"
                        Padding="28,0,28,122"
                        Spacing="36">

                <!-- Mobile-inspired immersive Hero, adapted for desktop width. -->
                <Grid x:Name="HeroContainer"
                      Height="620"
                      Margin="-28,0,-28,-172">
                    <controls:CachedImage x:Name="HeroImage"
                                          LazyLoadingEnabled="False"
                                          Stretch="UniformToFill"/>

                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="0,1">
                                <GradientStop Color="#16000000" Offset="0"/>
                                <GradientStop Color="#08000000" Offset="0.42"/>
                                <GradientStop Color="#28000000" Offset="0.74"/>
                                <GradientStop Color="#40000000" Offset="0.92"/>
                                <GradientStop Color="#50000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Floating top controls -->
                    <Grid Margin="42,34,42,0"
                          VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ServerPillButton"
                                Grid.Column="0"
                                Height="58"
                                MinWidth="180"
                                Padding="17,0"
                                CornerRadius="29"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                Click="ServerPill_Click">
                            <Button.Background>
                                <lg:LiquidGlassBrush BlurAmount="2.05"
                                                     BloomAmount="0.18"
                                                     RefThickness="34"
                                                     RefFactor="2.15"
                                                     RefDispersion="4.5"
                                                     GlareFactor="62"
                                                     TintA="0.18"
                                                     TintR="232"
                                                     TintG="238"
                                                     TintB="255"
                                                     ShapeRadius="0.96"
                                                     ShapeRoundness="3.9"/>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="9"
                                        Background="#44000000">
                                    <TextBlock Text="A"
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="ServerNameBlock"
                                           Text="服务器"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="⌄"
                                           Foreground="#E6FFFFFF"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Width="58"
                                Height="58"
                                Padding="0"
                                CornerRadius="29"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                Click="Search_Click">
                            <Button.Background>
                                <lg:LiquidGlassBrush BlurAmount="2.05"
                                                     BloomAmount="0.18"
                                                     RefThickness="34"
                                                     RefFactor="2.15"
                                                     RefDispersion="4.5"
                                                     GlareFactor="62"
                                                     TintA="0.18"
                                                     TintR="232"
                                                     TintG="238"
                                                     TintB="255"
                                                     ShapeRadius="0.98"
                                                     ShapeRoundness="4.0"/>
                            </Button.Background>
                            <FontIcon Glyph="&#xE721;"
                                      Foreground="White"
                                      FontSize="22"/>
                        </Button>
                    </Grid>

                    <!-- Hero copy -->
                    <StackPanel VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="44,0,44,154"
                                MaxWidth="860"
                                Spacing="11">
                        <TextBlock x:Name="WelcomeBlock"
                                   Foreground="#DDEBFA"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="HeroTitleBlock"
                                   Text="AsterPlay"
                                   Foreground="White"
                                   FontSize="46"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="HeroMetaBlock"
                                   Foreground="#F2F3F5"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="HeroOverviewBlock"
                                   Foreground="#E0E3E8"
                                   FontSize="16"
                                   LineHeight="25"
                                   MaxWidth="820"
                                   MaxHeight="66"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="10"
                                    Margin="0,5,0,0">
                            <Button x:Name="HeroPlayButton"
                                    Style="{StaticResource HeroActionButtonStyle}"
                                    Content="▶  播放"
                                    Click="HeroPlay_Click"/>
                            <Button Style="{StaticResource HeroActionButtonStyle}"
                                    Content="详情"
                                    Click="HeroDetails_Click"/>
                            <Button x:Name="HeroFavoriteButton"
                                    Style="{StaticResource HeroActionButtonStyle}"
                                    Content="♡  收藏"
                                    Click="HeroFavorite_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Continue watching -->
                <StackPanel x:Name="ContinueSection"
                            Visibility="Collapsed"
                            Spacing="16">
                    <Grid>
                        <TextBlock Text="继续播放"
                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button x:Name="ResumePreviousButton"
                                    Style="{StaticResource RoundActionButtonStyle}"
                                    Content="‹"
                                    Tag="-1"
                                    Click="ResumeArrow_Click"/>
                            <Button x:Name="ResumeNextButton"
                                    Style="{StaticResource RoundActionButtonStyle}"
                                    Content="›"
                                    Tag="1"
                                    Click="ResumeArrow_Click"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="ResumeScroller"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  ZoomMode="Disabled"
                                  ViewChanged="ResumeScroller_ViewChanged"
                                  SizeChanged="ResumeScroller_SizeChanged">
                        <ItemsControl x:Name="ResumeGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="320"
                                            Margin="0,0,18,0"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{Binding}"
                                            RenderTransformOrigin="0.5,0.5"
                                            PointerEntered="MediaCard_PointerEntered"
                                            PointerExited="MediaCard_PointerExited"
                                            Click="ResumeTile_Click"
                                            RightTapped="ResumeTile_RightTapped">
                                        <Button.RenderTransform>
                                            <ScaleTransform ScaleX="1"
                                                            ScaleY="1"/>
                                        </Button.RenderTransform>
                                        <StackPanel Width="320"
                                                    Spacing="9">
                                            <Border Width="320"
                                                    Height="180"
                                                    CornerRadius="22"
                                                    Background="{ThemeResource AsterCardBackgroundBrush}"
                                                    BorderBrush="{ThemeResource AsterCardBorderBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <controls:CachedImage SourceUrl="{Binding BackdropUrl}"
                                                                          Stretch="UniformToFill"/>
                                                    <Rectangle>
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0"
                                                                                 EndPoint="0,1">
                                                                <GradientStop Color="#00000000" Offset="0.42"/>
                                                                <GradientStop Color="#B0000000" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,12,12,0"
                                                            Padding="8,4"
                                                            CornerRadius="10"
                                                            Background="#66000000">
                                                        <TextBlock Text="{Binding LastPlayedText}"
                                                                   Foreground="White"
                                                                   FontSize="11"/>
                                                    </Border>

                                                    <Grid VerticalAlignment="Bottom"
                                                          Margin="16,0,16,13">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="▶"
                                                                   Foreground="White"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                        <ProgressBar Grid.Column="2"
                                                                     Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding PlayedPercentage}"
                                                                     Height="4"
                                                                     VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding ShortProgressText}"
                                                                   Foreground="White"
                                                                   FontSize="12"
                                                                   Margin="11,0,0,0"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{Binding ResumeTitle}"
                                                       Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="{Binding EpisodeText}"
                                                       Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                       FontSize="12"
                                                       LineHeight="17"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2"
                                                       MinHeight="34"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- My media -->
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="我的媒体"
                                       Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="浏览你的媒体库"
                                       Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                       FontSize="12"
                                       Opacity="0.82"/>
                        </StackPanel>
                        <Button Content="更多  ›"
                                Style="{StaticResource SectionMoreButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="OpenLibrary_Click"/>
                    </Grid>

                    <ItemsRepeater x:Name="LibrariesGrid">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="286"
                                               MinItemHeight="154"
                                               MinColumnSpacing="16"
                                               MinRowSpacing="16"
                                               ItemsJustification="Start"
                                               ItemsStretch="None"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Button Width="286"
                                        Height="154"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        Tag="{Binding}"
                                        RenderTransformOrigin="0.5,0.5"
                                        PointerEntered="MediaCard_PointerEntered"
                                        PointerExited="MediaCard_PointerExited"
                                        Click="LibraryTile_Click">
                                    <Button.RenderTransform>
                                        <ScaleTransform ScaleX="1"
                                                        ScaleY="1"/>
                                    </Button.RenderTransform>
                                    <Border CornerRadius="20"
                                            Background="{ThemeResource AsterCardBackgroundBrush}"
                                            BorderBrush="{ThemeResource AsterCardBorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <controls:CachedImage SourceUrl="{Binding BackdropUrl}"
                                                                  Stretch="UniformToFill"
                                                                  Opacity="0.88"/>
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0"
                                                                         EndPoint="0,1">
                                                        <GradientStop Color="#12000000" Offset="0"/>
                                                        <GradientStop Color="#A6000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Border Width="30"
                                                    Height="30"
                                                    CornerRadius="15"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,12,12,0"
                                                    Background="#52000000"
                                                    BorderBrush="#3FFFFFFF"
                                                    BorderThickness="1">
                                                <TextBlock Text="›"
                                                           Foreground="White"
                                                           FontSize="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="1,-2,0,0"/>
                                            </Border>

                                            <StackPanel VerticalAlignment="Bottom"
                                                        Margin="18"
                                                        Spacing="3">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="White"
                                                           FontSize="21"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Foreground="#E0E4EA"
                                                           FontSize="12"
                                                           Opacity="0.92"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Library sections -->
                <ItemsControl x:Name="LibrarySectionsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="16"
                                        Margin="0,0,0,30">
                                <Grid>
                                    <StackPanel Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CountLabel}"
                                                   Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                   FontSize="12"
                                                   Opacity="0.82"/>
                                    </StackPanel>

                                    <Button Content="更多  ›"
                                            Style="{StaticResource SectionMoreButtonStyle}"
                                            HorizontalAlignment="Right"
                                            Tag="{Binding}"
                                            Click="LibrarySectionMore_Click"/>
                                </Grid>

                                <ItemsRepeater ItemsSource="{Binding Items}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="158"
                                                           MinItemHeight="278"
                                                           MinColumnSpacing="16"
                                                           MinRowSpacing="20"
                                                           ItemsJustification="Start"
                                                           ItemsStretch="None"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Button MinWidth="158"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    Tag="{Binding}"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    PointerEntered="MediaCard_PointerEntered"
                                                    PointerExited="MediaCard_PointerExited"
                                                    Click="SectionMedia_Click">
                                                <Button.RenderTransform>
                                                    <ScaleTransform ScaleX="1"
                                                                    ScaleY="1"/>
                                                </Button.RenderTransform>
                                                <StackPanel Spacing="8">
                                                    <Border Height="232"
                                                            CornerRadius="18"
                                                            Background="{ThemeResource AsterCardBackgroundBrush}"
                                                            BorderBrush="{ThemeResource AsterCardBorderBrush}"
                                                            BorderThickness="1">
                                                        <controls:CachedImage SourceUrl="{Binding PosterUrl}"
                                                                              Stretch="UniformToFill"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{ThemeResource AsterPrimaryTextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               LineHeight="18"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="2"
                                                               MinHeight="36"/>
                                                    <TextBlock Text="{Binding Meta}"
                                                               Foreground="{ThemeResource AsterSecondaryTextBrush}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="NoServerState"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14"
                        Margin="24">
                <Border Width="86"
                        Height="86"
                        CornerRadius="30"
                        Background="{ThemeResource AsterCardBackgroundBrush}"
                        BorderBrush="{ThemeResource AsterCardBorderBrush}"
                        BorderThickness="1">
                    <FontIcon Glyph="&#xE7F8;"
                              FontSize="36"
                              Foreground="{ThemeResource AsterSecondaryTextBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="暂无服务器"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AsterPrimaryTextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="请先添加服务器"
                           FontSize="15"
                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
                <Button Content="前往服务器页面"
                        Margin="0,10,0,0"
                        Padding="24,11"
                        CornerRadius="22"
                        HorizontalAlignment="Center"
                        Click="GoToServers_Click"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="LoadingState"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                <ProgressRing x:Name="LoadingRing"
                              Width="38"
                              Height="38"
                              IsActive="False"/>
                <TextBlock x:Name="LoadingTextBlock"
                           Text="正在加载"
                           FontSize="15"
                           Foreground="{ThemeResource AsterSecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
