<Window x:Class="AsterPlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:AsterPlay.Controls"
        Title="AsterPlay"
        Width="1280"
        Height="800"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackground}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="#D8D9DE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FloatingNavButton" TargetType="Button">
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#9CA1AC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#D80A0D13"
                BorderBrush="#10FFFFFF"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="7" Background="#0A84FF">
                        <TextBlock Text="A"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="AsterPlay"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#F5F5F7"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <TextBlock x:Name="PageTitleBlock"
                           Grid.Column="1"
                           Text=""
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#A9ADB6"
                           FontSize="13"/>

                <Button Grid.Column="2"
                        Style="{StaticResource CaptionButton}"
                        Content="—"
                        Click="Minimize_Click"/>
                <Button x:Name="MaximizeButton"
                        Grid.Column="3"
                        Style="{StaticResource CaptionButton}"
                        Content="□"
                        Click="Maximize_Click"/>
                <Button Grid.Column="4"
                        Style="{StaticResource CloseCaptionButton}"
                        Content="✕"
                        Click="Close_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#07090D">
            <Grid IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="760"
                         Height="520"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="-220,-250,0,0"
                         Opacity="0.28">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#6E2F86FF" Offset="0"/>
                            <GradientStop Color="#1E2357A7" Offset="0.52"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="52"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="680"
                         Height="520"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,-220,-280"
                         Opacity="0.22">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#5C55C7FF" Offset="0"/>
                            <GradientStop Color="#182178A6" Offset="0.54"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="58"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>

            <Border x:Name="ContentSurface"
                    Background="#A807090D">
                <ContentControl x:Name="RootContent"/>
            </Border>

            <controls:LiquidGlassPanel x:Name="BottomNavigation"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Padding="7"
                    CornerRadius="28"
                    Background="#8A171D29"
                    BorderBrush="{StaticResource LiquidGlassEdgeBrush}"
                    BorderThickness="1"
                    BloomOpacity="0.42"
                    GlareOpacity="0.34"
                    EdgeLightOpacity="0.62"
                    Panel.ZIndex="50">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="HomeNavButton"
                            Style="{StaticResource FloatingNavButton}"
                            Click="HomeNav_Click">
                        <StackPanel>
                            <TextBlock Text="⌂"
                                       FontSize="20"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="首页"
                                       Margin="0,3,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="LibraryNavButton"
                            Style="{StaticResource FloatingNavButton}"
                            Click="LibraryNav_Click">
                        <StackPanel>
                            <TextBlock Text="▦"
                                       FontSize="18"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="媒体库"
                                       Margin="0,3,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ServersNavButton"
                            Style="{StaticResource FloatingNavButton}"
                            Click="ServersNav_Click">
                        <StackPanel>
                            <TextBlock Text="◫"
                                       FontSize="18"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="服务器"
                                       Margin="0,3,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SettingsNavButton"
                            Style="{StaticResource FloatingNavButton}"
                            Click="SettingsNav_Click">
                        <StackPanel>
                            <TextBlock Text="⚙"
                                       FontSize="17"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="设置"
                                       Margin="0,3,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:LiquidGlassPanel>
        </Grid>
    </Grid>
</Window>
