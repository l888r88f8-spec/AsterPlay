<Window x:Class="AsterPlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AsterPlay"
        Width="1280"
        Height="800"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackground}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="#D8D9DE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#B7BBC4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5111216" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="7" Background="#0A84FF">
                        <TextBlock Text="A" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="AsterPlay" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#F5F5F7"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <TextBlock x:Name="PageTitleBlock"
                           Grid.Column="1"
                           Text=""
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#A9ADB6"
                           FontSize="13"/>

                <Button Grid.Column="2" Style="{StaticResource CaptionButton}"
                        Content="—" Click="Minimize_Click"/>
                <Button x:Name="MaximizeButton" Grid.Column="3"
                        Style="{StaticResource CaptionButton}"
                        Content="□" Click="Maximize_Click"/>
                <Button Grid.Column="4" Style="{StaticResource CloseCaptionButton}"
                        Content="✕" Click="Close_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="Sidebar"
                    Grid.Column="0"
                    Background="#F5111216"
                    BorderBrush="#10FFFFFF"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,16,0,0">
                        <Button x:Name="HomeNavButton"
                                Style="{StaticResource SidebarNavButton}"
                                Click="HomeNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂" Width="28" FontSize="18"/>
                                <TextBlock Text="首页" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="LibraryNavButton"
                                Style="{StaticResource SidebarNavButton}"
                                Click="LibraryNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦" Width="28" FontSize="17"/>
                                <TextBlock Text="媒体库" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ServersNavButton"
                                Style="{StaticResource SidebarNavButton}"
                                Click="ServersNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◫" Width="28" FontSize="16"/>
                                <TextBlock Text="服务器" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="SettingsNavButton"
                                Style="{StaticResource SidebarNavButton}"
                                Click="SettingsNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" Width="28" FontSize="16"/>
                                <TextBlock Text="设置" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="2" Margin="14,0,14,16"
                            Padding="12"
                            CornerRadius="12"
                            Background="#0FFFFFFF">
                        <StackPanel>
                            <TextBlock Text="AsterPlay" Foreground="#D8DAE0" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Native Emby Client" Foreground="#676D78" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    x:Name="ContentSurface"
                    Background="{StaticResource AppBackground}">
                <ContentControl x:Name="RootContent"/>
            </Border>
        </Grid>
    </Grid>
</Window>
