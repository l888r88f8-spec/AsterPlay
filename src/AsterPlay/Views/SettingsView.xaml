<UserControl x:Class="AsterPlay.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AsterPlay.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="Transparent">
        <StackPanel Margin="46,36,46,126"
                    MaxWidth="920"
                    HorizontalAlignment="Left">
            <TextBlock Text="设置"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="36"
                       FontWeight="SemiBold"
                       Foreground="White"/>
            <TextBlock Text="AsterPlay 的应用与播放偏好"
                       Margin="0,7,0,30"
                       Foreground="#9CA3B1"
                       FontSize="14"/>

            <controls:LiquidGlassPanel Padding="26"
                                       CornerRadius="28"
                                       Background="#84171E2A"
                                       BloomOpacity="0.32"
                                       GlareOpacity="0.25">
                <StackPanel>
                    <TextBlock Text="常规"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <CheckBox x:Name="RestoreSessionCheckBox"
                              Content="启动时恢复上次登录"
                              Margin="0,20,0,0"
                              Foreground="#EEF0F5"
                              FontSize="15"
                              Checked="SettingChanged"
                              Unchecked="SettingChanged"/>
                    <TextBlock Text="关闭后不会删除登录信息；Token 仍使用 Windows DPAPI 保护。"
                               Margin="24,7,0,0"
                               Foreground="#858D9B"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </controls:LiquidGlassPanel>

            <controls:LiquidGlassPanel Padding="26"
                                       CornerRadius="28"
                                       Background="#84171E2A"
                                       BloomOpacity="0.34"
                                       GlareOpacity="0.25"
                                       Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="播放器"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="控制栏自动隐藏"
                                       Foreground="#EEF0F5"
                                       FontSize="15"/>
                            <TextBlock Text="鼠标静止后隐藏播放器控制层"
                                       Margin="0,5,0,0"
                                       Foreground="#858D9B"/>
                        </StackPanel>
                        <ComboBox x:Name="AutoHideComboBox"
                                  Grid.Column="1"
                                  Height="38"
                                  SelectionChanged="SettingChanged">
                            <ComboBoxItem Tag="2" Content="2 秒"/>
                            <ComboBoxItem Tag="3" Content="3 秒"/>
                            <ComboBoxItem Tag="5" Content="5 秒"/>
                            <ComboBoxItem Tag="8" Content="8 秒"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </controls:LiquidGlassPanel>

            <controls:LiquidGlassPanel Padding="26"
                                       CornerRadius="28"
                                       Background="#84171E2A"
                                       BloomOpacity="0.30"
                                       GlareOpacity="0.22"
                                       Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="关于"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="AsterPlay · Native Windows Emby Client"
                               Margin="0,18,0,0"
                               Foreground="#EEF0F5"
                               FontSize="15"/>
                    <TextBlock Text="WPF · .NET 8 · libmpv Render API · LogVar"
                               Margin="0,6,0,0"
                               Foreground="#858D9B"/>
                    <TextBlock Text="Liquid Glass visual system inspired by LiquidGlassWinUI"
                               Margin="0,5,0,0"
                               Foreground="#657185"
                               FontSize="12"/>
                </StackPanel>
            </controls:LiquidGlassPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
