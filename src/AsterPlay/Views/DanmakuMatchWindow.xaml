<Window x:Class="AsterPlay.Views.DanmakuMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="弹幕剧集匹配"
        Width="880"
        Height="610"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#15161B"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="LogVar 剧集匹配"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="CurrentMediaTextBlock"
                       Margin="0,7,0,0"
                       Foreground="#9BA2AE"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="CurrentMatchTextBlock"
                       Margin="0,4,0,0"
                       Foreground="#7FC8FF"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Height="36"
                     VerticalContentAlignment="Center"
                     Padding="10,0"/>

            <Button x:Name="SearchButton"
                    Grid.Column="1"
                    Content="搜索剧集"
                    MinWidth="92"
                    Height="36"
                    Margin="10,0,0,0"
                    IsDefault="True"
                    Click="Search_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="1. 选择剧集 / 季度"
                           Foreground="#C8CDD6"
                           FontWeight="SemiBold"
                           Margin="2,0,0,8"/>

                <Border Grid.Row="1"
                        Background="#1D1F26"
                        CornerRadius="8"
                        Padding="8">
                    <Grid>
                        <ListBox x:Name="SeriesListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="SeriesListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,9"
                                            Margin="0,2"
                                            Background="#242730"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DetailText}"
                                                       Foreground="#969EAA"
                                                       FontSize="12"
                                                       Margin="0,5,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="SeriesEmptyTextBlock"
                                   Text="输入剧名搜索 LogVar 剧集"
                                   Foreground="#7D8490"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="2. 选择当前集"
                           Foreground="#C8CDD6"
                           FontWeight="SemiBold"
                           Margin="2,0,0,8"/>

                <Border Grid.Row="1"
                        Background="#1D1F26"
                        CornerRadius="8"
                        Padding="8">
                    <Grid>
                        <ListBox x:Name="EpisodesListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="EpisodesListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,9"
                                            Margin="0,2"
                                            Background="#242730"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding EpisodeTitle}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DetailText}"
                                                       Foreground="#969EAA"
                                                       FontSize="12"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EpisodesEmptyTextBlock"
                                   Text="先选择左侧剧集"
                                   Foreground="#7D8490"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="#AEB4BF"
                       TextWrapping="Wrap"/>

            <Button Grid.Column="1"
                    Content="恢复自动匹配"
                    MinWidth="112"
                    Height="34"
                    Margin="12,0,8,0"
                    Click="Automatic_Click"/>

            <Button Grid.Column="2"
                    Content="取消"
                    Width="80"
                    Height="34"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>

            <Button Grid.Column="3"
                    Content="绑定剧集"
                    MinWidth="94"
                    Height="34"
                    Click="UseSelected_Click"/>
        </Grid>
    </Grid>
</Window>
