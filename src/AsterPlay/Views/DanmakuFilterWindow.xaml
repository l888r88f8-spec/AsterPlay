<Window x:Class="AsterPlay.Views.DanmakuFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="弹幕过滤"
        Width="620"
        Height="540"
        MinWidth="520"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#15161B">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="弹幕过滤"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Margin="0,7,0,0"
                       Foreground="#858C98"
                       TextWrapping="Wrap"
                       Text="屏蔽词按包含匹配；发送者按 LogVar 返回的 sender/userId 精确匹配。每行填写一项。"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="屏蔽词"
                       Foreground="#C8CDD6"
                       FontWeight="SemiBold"
                       Margin="2,0,0,7"/>
            <TextBox x:Name="BlockedWordsTextBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     Padding="10"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="屏蔽发送者"
                       Foreground="#C8CDD6"
                       FontWeight="SemiBold"
                       Margin="2,0,0,7"/>
            <TextBox x:Name="BlockedUsersTextBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     Padding="10"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CountTextBlock"
                       VerticalAlignment="Center"
                       Foreground="#8F96A1"/>

            <Button Grid.Column="1"
                    Content="取消"
                    Width="82"
                    Height="34"
                    Margin="12,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>

            <Button Grid.Column="2"
                    Content="保存"
                    Width="82"
                    Height="34"
                    IsDefault="True"
                    Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
