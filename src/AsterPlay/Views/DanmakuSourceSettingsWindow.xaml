<Window x:Class="AsterPlay.Views.DanmakuSourceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="弹幕源"
        Width="520"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#15161B">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="弹幕数据源"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="来源"
                       Foreground="#AEB4BF"
                       Margin="0,0,0,6"/>
            <ComboBox x:Name="SourceComboBox"
                      Height="34"
                      SelectionChanged="SourceComboBox_SelectionChanged"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Border x:Name="BuiltInPanel"
                    Background="#1D1F26"
                    CornerRadius="8"
                    Padding="14">
                <TextBlock Foreground="#C9CDD5"
                           TextWrapping="Wrap"
                           Text="内置测试源仅用于验证渲染和调度，不访问外部弹幕服务。"/>
            </Border>

            <Border x:Name="LogVarPanel"
                    Background="#1D1F26"
                    CornerRadius="8"
                    Padding="14"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="LogVar 服务器地址"
                               Foreground="#AEB4BF"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="LogVarUrlTextBox"
                             Height="34"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Foreground="#858C98"
                               FontSize="12"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="填写基础地址，例如 http://192.168.1.10:9321；如果配置了 TOKEN，可填写 https://域名/TOKEN。不要填写 /api/v2/... 接口路径。"/>
                </StackPanel>
            </Border>

            <Border x:Name="DandanPlayPanel"
                    Background="#1D1F26"
                    CornerRadius="8"
                    Padding="14"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="AppId"
                               Foreground="#AEB4BF"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="DandanPlayAppIdTextBox"
                             Height="34"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Text="AppSecret"
                               Foreground="#AEB4BF"
                               Margin="0,12,0,6"/>
                    <PasswordBox x:Name="DandanPlayAppSecretBox"
                                 Height="34"
                                 VerticalContentAlignment="Center"/>

                    <CheckBox x:Name="DandanPlayRelatedCheckBox"
                              Margin="0,14,0,0"
                              Foreground="#D6DAE1"
                              Content="同时获取关联第三方弹幕（withRelated=true）"
                              IsChecked="True"/>

                    <TextBlock Foreground="#858C98"
                               FontSize="12"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="AppSecret 使用 Windows DPAPI 加密后保存，不会以明文写入配置文件。"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ValidationTextBlock"
                       VerticalAlignment="Center"
                       Foreground="#FF9D9D"
                       TextWrapping="Wrap"/>

            <Button Grid.Column="1"
                    Content="取消"
                    Width="82"
                    Height="34"
                    Margin="12,0,8,0"
                    Click="Cancel_Click"/>

            <Button Grid.Column="2"
                    Content="保存"
                    Width="82"
                    Height="34"
                    IsDefault="True"
                    Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
