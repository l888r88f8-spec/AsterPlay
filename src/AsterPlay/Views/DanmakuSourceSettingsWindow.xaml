<Window x:Class="AsterPlay.Views.DanmakuSourceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LogVar 弹幕服务器"
        Width="520"
        Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#15161B">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="LogVar 弹幕服务器"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,0"
                       Foreground="#858C98"
                       TextWrapping="Wrap"
                       Text="AsterPlay 仅使用 LogVar / danmu_api。配置方式参考 qEmby：服务器地址与 Access Token 分开填写。"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,0"
                Background="#1D1F26"
                CornerRadius="8"
                Padding="16">
            <StackPanel>
                <TextBlock Text="服务器地址"
                           Foreground="#AEB4BF"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="LogVarUrlTextBox"
                         Height="34"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Access Token（可选）"
                           Foreground="#AEB4BF"
                           Margin="0,14,0,6"/>
                <PasswordBox x:Name="LogVarAccessTokenBox"
                             Height="34"
                             VerticalContentAlignment="Center"/>

                <TextBlock Foreground="#858C98"
                           FontSize="12"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Text="地址示例：http://192.168.1.10:9321。不要填写 /api/v2/... 路径；如果 LogVar 配置了 TOKEN，请单独填在 Access Token。Token 使用 Windows DPAPI 加密保存。"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ValidationTextBlock"
                       VerticalAlignment="Center"
                       Foreground="#FF9D9D"
                       TextWrapping="Wrap"/>

            <Button Grid.Column="1"
                    Content="取消"
                    Width="82"
                    Height="34"
                    Margin="12,0,8,0"
                    Click="Cancel_Click"/>

            <Button Grid.Column="2"
                    Content="保存"
                    Width="82"
                    Height="34"
                    IsDefault="True"
                    Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
