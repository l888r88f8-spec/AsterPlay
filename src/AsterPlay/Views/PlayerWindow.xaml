<UserControl x:Class="AsterPlay.Views.PlayerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
             xmlns:controls="clr-namespace:AsterPlay.Controls"
             Focusable="True"
             Background="Black"
             PreviewKeyDown="PlayerWindow_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="PlayerIconButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerPillButton" TargetType="Button" BasedOn="{StaticResource PlayerIconButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PlayerComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ProgressSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center"
                                   Height="22">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White"
                                                         Stroke="#55000000"
                                                         StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PlayerRoot"
          Background="Black"
          MouseMove="PlayerRoot_MouseMove"
          PreviewMouseLeftButtonDown="PlayerRoot_PreviewMouseLeftButtonDown">

        <gl:GLWpfControl x:Name="VideoSurface"
                         Focusable="False"
                         IsHitTestVisible="False"
                         RenderTransformOrigin="0.5,0.5"
                         Render="VideoSurface_OnRender">
            <gl:GLWpfControl.RenderTransform>
                <ScaleTransform ScaleY="-1"/>
            </gl:GLWpfControl.RenderTransform>
        </gl:GLWpfControl>

        <controls:DanmakuOverlay x:Name="DanmakuOverlay"
                                 Visibility="Collapsed"
                                 IsHitTestVisible="False"
                                 Focusable="False"
                                 Panel.ZIndex="5"/>

        <Border x:Name="TopInfoPanel"
                VerticalAlignment="Top"
                Height="118"
                Panel.ZIndex="24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#C9000000" Offset="0"/>
                    <GradientStop Color="#56000000" Offset="0.62"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="22,14,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource PlayerIconButton}"
                            Content="‹"
                            FontSize="30"
                            ToolTip="返回"
                            Click="ExitPlayer_Click"/>
                    <Border Margin="10,2,0,0"
                            Padding="11,7"
                            Background="#13000000"
                            CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#42D66D"
                                     VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="NetworkSpeedBlock"
                                       Text="-- MB/s"
                                       Foreground="#E9EAF0"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="20,2">
                    <TextBlock x:Name="TitleBlock"
                               Text=""
                               Foreground="White"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="620"/>
                    <TextBlock x:Name="EpisodeTitleBlock"
                               Text=""
                               Foreground="#A6AAB3"
                               FontSize="12"
                               TextAlignment="Center"
                               Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="620"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="DiagnosticsPanel"
                Width="330"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,22,80"
                Padding="18"
                CornerRadius="18"
                Background="#E516171C"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed"
                Panel.ZIndex="32">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="媒体信息"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="简略"
                               DockPanel.Dock="Right"
                               Foreground="#737A86"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <TextBlock Text="播放方式" Foreground="#737A86" FontSize="11"/>
                <TextBlock x:Name="DiagnosticsMethodBlock" Foreground="White" Margin="0,3,0,12" TextWrapping="Wrap"/>

                <TextBlock Text="视频" Foreground="#737A86" FontSize="11"/>
                <TextBlock x:Name="DiagnosticsVideoBlock" Foreground="#E7E8ED" Margin="0,3,0,12" TextWrapping="Wrap"/>

                <TextBlock Text="音频" Foreground="#737A86" FontSize="11"/>
                <TextBlock x:Name="DiagnosticsAudioBlock" Foreground="#E7E8ED" Margin="0,3,0,12" TextWrapping="Wrap"/>

                <TextBlock Text="缓存" Foreground="#737A86" FontSize="11"/>
                <TextBlock x:Name="DiagnosticsCacheBlock" Foreground="#E7E8ED" Margin="0,3,0,0" TextWrapping="Wrap"/>

                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="DiagnosticsDecisionBlock"/>
                    <TextBlock x:Name="DiagnosticsSourceBlock"/>
                    <TextBlock x:Name="DiagnosticsHwdecBlock"/>
                    <TextBlock x:Name="DiagnosticsVoBlock"/>
                    <TextBlock x:Name="DiagnosticsBitrateBlock"/>
                    <TextBlock x:Name="DiagnosticsTracksBlock"/>
                    <TextBlock x:Name="DiagnosticsOffsetBlock"/>
                    <TextBlock x:Name="DiagnosticsMediaSourceBlock"/>
                    <TextBlock x:Name="DiagnosticsDanmakuBlock"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="MoreSettingsPanel"
                Width="360"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,22,190"
                Padding="16"
                CornerRadius="18"
                Background="#EF17181D"
                BorderBrush="#24FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed"
                Panel.ZIndex="34">
            <StackPanel>
                <TextBlock Text="播放设置"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="2,0,0,14"/>

                <WrapPanel>
                    <Button x:Name="DanmakuButton"
                            Style="{StaticResource PlayerPillButton}"
                            Content="弹幕"
                            Margin="0,0,8,8"
                            Click="Danmaku_Click"/>
                    <Button x:Name="DanmakuSettingsButton"
                            Style="{StaticResource PlayerPillButton}"
                            Content="弹幕设置"
                            Margin="0,0,8,8"
                            Click="DanmakuSettings_Click"/>
                    <Button x:Name="DanmakuSourceButton"
                            Style="{StaticResource PlayerPillButton}"
                            Content="LogVar"
                            Margin="0,0,8,8"
                            Click="DanmakuSource_Click"/>
                    <Button x:Name="DanmakuMatchButton"
                            Style="{StaticResource PlayerPillButton}"
                            Content="匹配"
                            Margin="0,0,8,8"
                            Click="DanmakuMatch_Click"/>
                    <Button x:Name="DiagnosticsButton"
                            Style="{StaticResource PlayerPillButton}"
                            Content="详细信息"
                            Margin="0,0,8,8"
                            Click="Diagnostics_Click"/>
                    <Button Style="{StaticResource PlayerPillButton}"
                            Content="⛶"
                            ToolTip="全屏"
                            Margin="0,0,8,8"
                            Click="Fullscreen_Click"/>
                </WrapPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MuteButton"
                            Style="{StaticResource PlayerIconButton}"
                            Content="🔊"
                            ToolTip="静音"
                            Click="Mute_Click"/>
                    <Slider x:Name="VolumeSlider"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="ControlsPanel"
                Height="210"
                VerticalAlignment="Bottom"
                Background="#01000000"
                Panel.ZIndex="30">
            <Grid>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#9A000000" Offset="0.34"/>
                            <GradientStop Color="#F4000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="24,12,24,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="58"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="SubtitleButton"
                                Style="{StaticResource PlayerIconButton}"
                                Content="CC"
                                FontSize="12"
                                ToolTip="字幕"
                                Margin="0,0,8,0"
                                Click="Subtitle_Click"/>
                        <Button x:Name="AudioButton"
                                Style="{StaticResource PlayerIconButton}"
                                Content="♫"
                                ToolTip="音频轨道"
                                Margin="0,0,8,0"
                                Click="Audio_Click"/>
                        <Button x:Name="MoreSettingsButton"
                                Style="{StaticResource PlayerIconButton}"
                                Content="•••"
                                ToolTip="更多设置"
                                Click="MoreSettings_Click"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="2,0">
                        <ProgressBar x:Name="BufferedProgressBar"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="0"
                                     Height="4"
                                     VerticalAlignment="Center"
                                     Background="#28FFFFFF"
                                     Foreground="#65FFFFFF"
                                     BorderThickness="0"/>
                        <ProgressBar x:Name="PlayedProgressBar"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="0"
                                     Height="4"
                                     VerticalAlignment="Center"
                                     Background="Transparent"
                                     Foreground="#F2F2F4"
                                     BorderThickness="0"/>
                        <Canvas x:Name="DanmakuHeatmapCanvas"
                                Height="18"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Opacity="0.68"/>
                        <Slider x:Name="PositionSlider"
                                Style="{StaticResource ProgressSliderStyle}"
                                Minimum="0"
                                Maximum="1"
                                IsMoveToPointEnabled="True"
                                VerticalAlignment="Center"
                                ValueChanged="PositionSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp"
                                LostMouseCapture="PositionSlider_LostMouseCapture"
                                Thumb.DragStarted="PositionSlider_DragStarted"
                                Thumb.DragCompleted="PositionSlider_DragCompleted"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="2,0">
                        <TextBlock x:Name="CurrentTimeBlock"
                                   Text="00:00"
                                   Foreground="#B9BDC6"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="DurationBlock"
                                   Text="00:00"
                                   Foreground="#B9BDC6"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="StatusBlock"
                                   VerticalAlignment="Center"
                                   Foreground="#A4A9B3"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <ComboBox x:Name="SpeedComboBox"
                                      Style="{StaticResource PlayerComboBox}"
                                      ToolTip="播放速度"
                                      SelectionChanged="SpeedComboBox_SelectionChanged"
                                      Margin="0,0,8,0"/>
                            <Button Style="{StaticResource PlayerIconButton}"
                                    Content="↶"
                                    ToolTip="快退 10 秒"
                                    Margin="0,0,8,0"
                                    Click="Back_Click"/>
                            <Button x:Name="PreviousEpisodeButton"
                                    Style="{StaticResource PlayerIconButton}"
                                    Content="⏮"
                                    ToolTip="上一集"
                                    Margin="0,0,8,0"
                                    Click="PreviousEpisode_Click"/>
                            <Button x:Name="PauseButton"
                                    Style="{StaticResource PlayerIconButton}"
                                    Width="50"
                                    Height="50"
                                    FontSize="20"
                                    Content="⏸"
                                    ToolTip="播放 / 暂停"
                                    Margin="0,0,8,0"
                                    Click="Pause_Click"/>
                            <Button x:Name="NextEpisodeButton"
                                    Style="{StaticResource PlayerIconButton}"
                                    Content="⏭"
                                    ToolTip="下一集"
                                    Margin="0,0,8,0"
                                    Click="NextEpisode_Click"/>
                            <Button Style="{StaticResource PlayerIconButton}"
                                    Content="↷"
                                    ToolTip="快进 10 秒"
                                    Margin="0,0,8,0"
                                    Click="Forward_Click"/>
                            <Button x:Name="ResolutionButton"
                                    Style="{StaticResource PlayerPillButton}"
                                    Content="HD"
                                    ToolTip="媒体参数"
                                    Margin="0,0,8,0"
                                    Click="Resolution_Click"/>
                            <Button x:Name="EpisodeListButton"
                                    Style="{StaticResource PlayerIconButton}"
                                    Content="☷"
                                    ToolTip="选集"
                                    Click="EpisodeList_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
