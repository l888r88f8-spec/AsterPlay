<Window x:Class="AsterPlay.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AsterPlay.Controls"
        Title="AsterPlay Player" Width="1280" Height="760"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        PreviewKeyDown="PlayerWindow_PreviewKeyDown">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="108"/>
        </Grid.RowDefinitions>

        <controls:MpvPlayerHost x:Name="PlayerHost" Grid.Row="0"/>

        <Border x:Name="ControlsPanel" Grid.Row="1"
                Background="#111116" BorderBrush="#22FFFFFF"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CurrentTimeBlock" Text="00:00"
                               Foreground="#C8CBD2" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Slider x:Name="PositionSlider" Grid.Column="1"
                            Minimum="0" Maximum="1"
                            VerticalAlignment="Center"
                            PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp"/>

                    <TextBlock x:Name="DurationBlock" Grid.Column="2" Text="00:00"
                               Foreground="#C8CBD2" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleBlock" Foreground="White"
                                   FontWeight="SemiBold" FontSize="15"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="StatusBlock" Foreground="#8F96A3"
                                   FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="−10s" Style="{StaticResource GlassButton}"
                                Padding="12,7" Margin="0,0,8,0" Click="Back_Click"/>
                        <Button x:Name="PauseButton" Content="播放 / 暂停"
                                Style="{StaticResource GlassButton}"
                                Padding="14,7" Margin="0,0,8,0" Click="Pause_Click"/>
                        <Button Content="+10s" Style="{StaticResource GlassButton}"
                                Padding="12,7" Margin="0,0,8,0" Click="Forward_Click"/>
                        <Button Content="音轨" Style="{StaticResource GlassButton}"
                                Padding="12,7" Margin="0,0,8,0" Click="Audio_Click"/>
                        <Button Content="字幕" Style="{StaticResource GlassButton}"
                                Padding="12,7" Margin="0,0,8,0" Click="Subtitle_Click"/>
                        <Button Content="全屏" Style="{StaticResource GlassButton}"
                                Padding="12,7" Click="Fullscreen_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="音量" Foreground="#BFC3CB"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="VolumeSlider" Width="110"
                                Minimum="0" Maximum="100" Value="100"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
