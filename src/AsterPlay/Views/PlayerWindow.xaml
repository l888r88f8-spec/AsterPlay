<Window x:Class="AsterPlay.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        xmlns:controls="clr-namespace:AsterPlay.Controls"
        Title="AsterPlay Player"
        Width="1280" Height="760"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        PreviewKeyDown="PlayerWindow_PreviewKeyDown">
    <Grid x:Name="PlayerRoot"
          Background="Black"
          MouseMove="PlayerRoot_MouseMove"
          PreviewMouseLeftButtonDown="PlayerRoot_PreviewMouseLeftButtonDown">

        <gl:GLWpfControl x:Name="VideoSurface"
                         Focusable="False"
                         IsHitTestVisible="False"
                         RenderTransformOrigin="0.5,0.5"
                         Render="VideoSurface_OnRender">
            <gl:GLWpfControl.RenderTransform>
                <ScaleTransform ScaleY="-1"/>
            </gl:GLWpfControl.RenderTransform>
        </gl:GLWpfControl>

        <controls:DanmakuOverlay x:Name="DanmakuOverlay"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"
                                    Focusable="False"
                                    Panel.ZIndex="5"/>

        <Border x:Name="DiagnosticsPanel"
                Width="390"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,24,24,0"
                Padding="16"
                CornerRadius="12"
                Background="#D914141B"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Panel.ZIndex="20">
            <StackPanel>
                <TextBlock Text="播放信息"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="播放方式" Foreground="#8F96A3" Margin="0,0,8,7"/>
                    <TextBlock x:Name="DiagnosticsMethodBlock" Grid.Row="0" Grid.Column="1" Foreground="#F1F3F6" TextWrapping="Wrap" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="1" Text="服务器决策" Foreground="#8F96A3" Margin="0,0,8,7"/>
                    <TextBlock x:Name="DiagnosticsDecisionBlock" Grid.Row="1" Grid.Column="1" Foreground="#C9CDD5" TextWrapping="Wrap" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="2" Text="源媒体" Foreground="#8F96A3" Margin="0,0,8,7"/>
                    <TextBlock x:Name="DiagnosticsSourceBlock" Grid.Row="2" Grid.Column="1" Foreground="#C9CDD5" TextWrapping="Wrap" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="3" Text="实际视频" Foreground="#8F96A3" Margin="0,0,8,7"/>
                    <TextBlock x:Name="DiagnosticsVideoBlock" Grid.Row="3" Grid.Column="1" Foreground="#F1F3F6" TextWrapping="Wrap" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="4" Text="实际音频" Foreground="#8F96A3" Margin="0,0,8,7"/>
                    <TextBlock x:Name="DiagnosticsAudioBlock" Grid.Row="4" Grid.Column="1" Foreground="#F1F3F6" TextWrapping="Wrap" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="5" Text="硬件解码" Foreground="#8F96A3" Margin="0,0,8,7"/>
                    <TextBlock x:Name="DiagnosticsHwdecBlock" Grid.Row="5" Grid.Column="1" Foreground="#F1F3F6" TextWrapping="Wrap" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="6" Text="视频输出" Foreground="#8F96A3" Margin="0,0,8,7"/>
                    <TextBlock x:Name="DiagnosticsVoBlock" Grid.Row="6" Grid.Column="1" Foreground="#C9CDD5" TextWrapping="Wrap" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="7" Text="码率" Foreground="#8F96A3" Margin="0,0,8,7"/>
                    <TextBlock x:Name="DiagnosticsBitrateBlock" Grid.Row="7" Grid.Column="1" Foreground="#C9CDD5" TextWrapping="Wrap" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="8" Text="音轨 / 字幕" Foreground="#8F96A3" Margin="0,0,8,7"/>
                    <TextBlock x:Name="DiagnosticsTracksBlock" Grid.Row="8" Grid.Column="1" Foreground="#C9CDD5" TextWrapping="Wrap" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="9" Text="缓存" Foreground="#8F96A3" Margin="0,0,8,7"/>
                    <TextBlock x:Name="DiagnosticsCacheBlock" Grid.Row="9" Grid.Column="1" Foreground="#C9CDD5" TextWrapping="Wrap" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="10" Text="续播偏移" Foreground="#8F96A3" Margin="0,0,8,7"/>
                    <TextBlock x:Name="DiagnosticsOffsetBlock" Grid.Row="10" Grid.Column="1" Foreground="#C9CDD5" TextWrapping="Wrap" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="11" Text="MediaSource" Foreground="#8F96A3" Margin="0,0,8,7"/>
                    <TextBlock x:Name="DiagnosticsMediaSourceBlock" Grid.Row="11" Grid.Column="1" Foreground="#8F96A3" TextWrapping="Wrap" Margin="0,0,0,7"/>

                    <TextBlock Grid.Row="12" Text="弹幕" Foreground="#8F96A3"/>
                    <TextBlock x:Name="DiagnosticsDanmakuBlock" Grid.Row="12" Grid.Column="1" Foreground="#C9CDD5" TextWrapping="Wrap"/>
                </Grid>

                <TextBlock Text="按 I 隐藏"
                           Foreground="#737A86"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <Border x:Name="ControlsPanel"
                Height="150"
                VerticalAlignment="Bottom"
                Background="#01000000"
                Panel.ZIndex="30">
            <Grid>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#B8000000" Offset="0.45"/>
                            <GradientStop Color="#F20A0A0E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="20,18,20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="CurrentTimeBlock"
                                   Text="00:00"
                                   Foreground="#D9DCE3"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <Slider x:Name="PositionSlider"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="1"
                                IsMoveToPointEnabled="True"
                                VerticalAlignment="Center"
                                ValueChanged="PositionSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp"
                                LostMouseCapture="PositionSlider_LostMouseCapture"
                                Thumb.DragStarted="PositionSlider_DragStarted"
                                Thumb.DragCompleted="PositionSlider_DragCompleted"/>

                        <TextBlock x:Name="DurationBlock"
                                   Grid.Column="2"
                                   Text="00:00"
                                   Foreground="#D9DCE3"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0">
                            <TextBlock x:Name="TitleBlock"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="StatusBlock"
                                       Foreground="#A6ACB7"
                                       FontSize="12"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Button Content="−10s"
                                    Style="{StaticResource GlassButton}"
                                    Padding="11,7"
                                    Margin="0,0,7,0"
                                    Click="Back_Click"/>
                            <Button x:Name="PauseButton"
                                    Content="暂停"
                                    Style="{StaticResource GlassButton}"
                                    Padding="13,7"
                                    Margin="0,0,7,0"
                                    Click="Pause_Click"/>
                            <Button Content="+10s"
                                    Style="{StaticResource GlassButton}"
                                    Padding="11,7"
                                    Margin="0,0,7,0"
                                    Click="Forward_Click"/>
                            <Button x:Name="MuteButton"
                                    Content="静音"
                                    Style="{StaticResource GlassButton}"
                                    Padding="11,7"
                                    Margin="0,0,7,0"
                                    Click="Mute_Click"/>
                            <Button x:Name="AudioButton"
                                    Content="音轨"
                                    Style="{StaticResource GlassButton}"
                                    Padding="11,7"
                                    Margin="0,0,7,0"
                                    Click="Audio_Click"/>
                            <Button x:Name="SubtitleButton"
                                    Content="字幕"
                                    Style="{StaticResource GlassButton}"
                                    Padding="11,7"
                                    Margin="0,0,7,0"
                                    Click="Subtitle_Click"/>
                            <ComboBox x:Name="SpeedComboBox"
                                      Width="70"
                                      Height="32"
                                      Margin="0,0,7,0"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="SpeedComboBox_SelectionChanged"/>
                            <Button x:Name="DanmakuButton"
                                    Content="弹幕"
                                    Style="{StaticResource GlassButton}"
                                    Padding="11,7"
                                    Margin="0,0,7,0"
                                    Click="Danmaku_Click"/>
                            <Button x:Name="DiagnosticsButton"
                                    Content="信息"
                                    Style="{StaticResource GlassButton}"
                                    Padding="11,7"
                                    Margin="0,0,7,0"
                                    Click="Diagnostics_Click"/>
                            <Button Content="全屏"
                                    Style="{StaticResource GlassButton}"
                                    Padding="11,7"
                                    Click="Fullscreen_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <TextBlock Text="音量"
                                       Foreground="#C9CDD5"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Slider x:Name="VolumeSlider"
                                    Width="105"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="100"
                                    ValueChanged="VolumeSlider_ValueChanged"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
