<Window x:Class="AsterPlay.Views.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AsterPlay.Controls"
        Title="AsterPlay Details"
        Width="1180" Height="820"
        MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#08080C">

    <Grid>
        <controls:CachedImage SourceUrl="{Binding BackdropUrl}"
               Stretch="UniformToFill"
               Opacity="0.34"/>

        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2A08080C" Offset="0"/>
                    <GradientStop Color="#B008080C" Offset="0.52"/>
                    <GradientStop Color="#FF08080C" Offset="0.82"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="46,42,46,52">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="260"
                            Height="390"
                            CornerRadius="16"
                            ClipToBounds="True"
                            VerticalAlignment="Top"
                            Background="#17171E"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1">
                        <controls:CachedImage SourceUrl="{Binding PosterUrl}"
                               Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Tagline}"
                                   Foreground="#D7DAE3"
                                   FontSize="15"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding Title}"
                                   Foreground="White"
                                   FontSize="46"
                                   FontWeight="Bold"
                                   LineHeight="52"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding OriginalTitle}"
                                   Foreground="#9FA5B2"
                                   FontSize="16"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding MetaLine}"
                                   Foreground="#ECEEF3"
                                   FontSize="15"
                                   Margin="0,16,0,0"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding Overview}"
                                   Foreground="#D5D8E1"
                                   FontSize="16"
                                   LineHeight="27"
                                   TextWrapping="Wrap"
                                   Margin="0,18,0,0"
                                   MaxHeight="190"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,24,0,0">
                            <Button x:Name="PlayButton"
                                    Content="{Binding ResumeLabel}"
                                    Style="{StaticResource GlassButton}"
                                    Padding="22,11"
                                    Margin="0,0,10,0"
                                    Click="Play_Click"/>

                            <Button x:Name="RestartButton"
                                    Content="从头播放"
                                    Style="{StaticResource GlassButton}"
                                    Padding="22,11"
                                    Margin="0,0,10,0"
                                    Click="Restart_Click"/>

                            <Button x:Name="FavoriteButton"
                                    Content="{Binding FavoriteLabel}"
                                    Style="{StaticResource GlassButton}"
                                    Padding="22,11"
                                    Margin="0,0,10,0"
                                    Click="Favorite_Click"/>

                            <Button Content="关闭"
                                    Style="{StaticResource GlassButton}"
                                    Padding="18,11"
                                    Click="Close_Click"/>
                        </StackPanel>

                        <StackPanel x:Name="CreatorPanel"
                                    Margin="0,22,0,0">
                            <TextBlock Text="{Binding DirectorsLine, StringFormat=导演  {0}}"
                                       Foreground="#C9CDD7"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding StudiosLine, StringFormat=制作  {0}}"
                                       Foreground="#9FA5B2"
                                       FontSize="13"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="SeriesSection"
                            Grid.Row="1"
                            Margin="0,42,0,0"
                            Visibility="Collapsed">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="剧集"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="SeriesStatusBlock"
                                       Text="选择一个季度查看剧集"
                                       Foreground="#9FA5B2"
                                       FontSize="13"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <ComboBox x:Name="SeasonComboBox"
                                  Grid.Column="1"
                                  MinWidth="180"
                                  Height="36"
                                  VerticalAlignment="Center"
                                  DisplayMemberPath="Title"
                                  SelectionChanged="SeasonComboBox_SelectionChanged"/>
                    </Grid>

                    <ItemsControl x:Name="EpisodeItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1AFFFFFF"
                                        BorderBrush="#28FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="12"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="210"
                                                Height="118"
                                                CornerRadius="10"
                                                ClipToBounds="True"
                                                Background="#17171E"
                                                VerticalAlignment="Top">
                                            <controls:CachedImage SourceUrl="{Binding ImageUrl}"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Background="#26FFFFFF"
                                                        CornerRadius="7"
                                                        Padding="8,4"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EpisodeLabel}"
                                                               Foreground="#F0F2F6"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"/>
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Title}"
                                                           Foreground="White"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Margin="10,0,10,0"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding RuntimeLabel}"
                                                           Foreground="#A8AEB9"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Overview}"
                                                       Foreground="#C7CBD4"
                                                       FontSize="13"
                                                       LineHeight="20"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="44"
                                                       Margin="0,9,0,0"/>

                                            <ProgressBar Grid.Row="2"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding PlayedPercentage, Mode=OneWay}"
                                                         Height="4"
                                                         Margin="0,10,0,0"/>

                                            <Grid Grid.Row="3"
                                                  Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding WatchStateLabel}"
                                                           Foreground="#9FA5B2"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"/>

                                                <Button Grid.Column="1"
                                                        Content="{Binding PlayLabel}"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource GlassButton}"
                                                        Padding="14,7"
                                                        Click="EpisodePlay_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="CastSection"
                            Grid.Row="2"
                            Margin="0,42,0,0">
                    <TextBlock Text="演员"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Cast}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="120"
                                                Margin="0,0,14,0">
                                        <Border Width="112"
                                                Height="150"
                                                CornerRadius="12"
                                                ClipToBounds="True"
                                                Background="#17171E">
                                            <controls:CachedImage SourceUrl="{Binding ImageUrl}"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,7,0,0"
                                                   MaxHeight="38"/>
                                        <TextBlock Text="{Binding Role}"
                                                   Foreground="#9FA5B2"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"
                                                   MaxHeight="34"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <Grid Grid.Row="3"
                      Margin="0,40,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="MediaSection">
                        <TextBlock Text="媒体信息"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,14"/>

                        <ItemsControl ItemsSource="{Binding MediaSummary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1CFFFFFF"
                                            BorderBrush="#28FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,9"
                                            Margin="0,0,0,8">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="#E4E7EE"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="TagsSection"
                                Grid.Column="2">
                        <TextBlock Text="标签与来源"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,14"/>

                        <ItemsControl ItemsSource="{Binding Genres}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1CFFFFFF"
                                            BorderBrush="#28FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="10,6"
                                            Margin="0,0,8,8">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="#E6E8ED"
                                                   FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Tags}"
                                      Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#12FFFFFF"
                                            CornerRadius="8"
                                            Padding="9,5"
                                            Margin="0,0,7,7">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="#AFB4BF"
                                                   FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding ProviderBadges}"
                                      Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#12FFFFFF"
                                            BorderBrush="#20FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="9,5"
                                            Margin="0,0,7,7">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="#969CA9"
                                                   FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="SourcesSection"
                            Grid.Row="4"
                            Margin="0,40,0,0">
                    <TextBlock Text="媒体源"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <ItemsControl ItemsSource="{Binding MediaSources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#14FFFFFF"
                                        BorderBrush="#24FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,12"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Foreground="#AAB0BC"
                                                   FontSize="12"
                                                   Margin="0,5,0,0">
                                            <Run Text="容器 "/>
                                            <Run Text="{Binding Container}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border x:Name="LoadingOverlay"
                Background="#D908080C">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="正在加载详情…"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="读取 Emby 详情数据"
                           Foreground="#9FA5B2"
                           FontSize="13"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
