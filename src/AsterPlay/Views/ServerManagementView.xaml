<UserControl x:Class="AsterPlay.Views.ServerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="42,34,42,22">
            <TextBlock Text="服务器" FontSize="34" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Text="管理可以登录的 Emby 服务器。这里不保存密码。"
                       Margin="0,6,0,0" Foreground="#8F96A3" FontSize="14"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="42,0,42,42">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SurfaceCardStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="已保存服务器" Style="{StaticResource SectionTitleStyle}" Margin="6,4,6,14"/>
                    <ListBox x:Name="ServerList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="ServerList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,12" Margin="0,0,0,8"
                                        CornerRadius="12" Background="#12FFFFFF">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White"
                                                   FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="{Binding Url}" Foreground="#7F8794"
                                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SurfaceCardStyle}" Padding="22" Margin="16,0,0,0">
                <StackPanel>
                    <TextBlock Text="添加 / 编辑" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="名称" Margin="0,18,0,6" Foreground="#B9BEC8"/>
                    <TextBox x:Name="NameBox" Height="38" Padding="10,7"/>
                    <TextBlock Text="服务器地址" Margin="0,16,0,6" Foreground="#B9BEC8"/>
                    <TextBox x:Name="UrlBox" Height="38" Padding="10,7"
                             Text="http://127.0.0.1:8096"/>
                    <Button Content="保存服务器"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,20,0,0"
                            Click="Save_Click"/>
                    <Button Content="删除选中服务器"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,10,0,0"
                            Click="Remove_Click"/>
                    <Button Content="返回登录"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,24,0,0"
                            Click="Done_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
