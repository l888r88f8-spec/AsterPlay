<UserControl x:Class="AsterPlay.Views.ServerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AsterPlay.Controls">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="46,36,46,24">
            <TextBlock Text="服务器"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="36"
                       FontWeight="SemiBold"
                       Foreground="White"/>
            <TextBlock Text="管理可以登录的 Emby 服务器。这里不保存密码。"
                       Margin="0,7,0,0"
                       Foreground="#9CA3B1"
                       FontSize="14"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="46,0,46,116">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <controls:LiquidGlassPanel Padding="18"
                                       CornerRadius="28"
                                       Background="#86171E2A"
                                       BloomOpacity="0.34"
                                       GlareOpacity="0.26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="已保存服务器"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="6,4,6,16"/>

                    <ListBox x:Name="ServerList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="ServerList_SelectionChanged">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,9"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemSurface"
                                                    Padding="15,13"
                                                    CornerRadius="15"
                                                    Background="#16FFFFFF"
                                                    BorderBrush="#1EFFFFFF"
                                                    BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemSurface" Property="Background" Value="#28FFFFFF"/>
                                                    <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#6C9BD3FF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemSurface" Property="Background" Value="#3B4D92D8"/>
                                                    <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#A0B9E0FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="15"/>
                                    <TextBlock Text="{Binding Url}"
                                               Foreground="#8D95A4"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </controls:LiquidGlassPanel>

            <controls:LiquidGlassPanel Grid.Column="1"
                                       Padding="24"
                                       Margin="18,0,0,0"
                                       CornerRadius="28"
                                       Background="#8A171E2A"
                                       BloomOpacity="0.40"
                                       GlareOpacity="0.30">
                <StackPanel>
                    <TextBlock Text="添加 / 编辑"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <TextBlock Text="名称"
                               Margin="0,20,0,7"
                               Foreground="#BBC1CC"/>
                    <TextBox x:Name="NameBox" Height="40"/>

                    <TextBlock Text="服务器地址"
                               Margin="0,18,0,7"
                               Foreground="#BBC1CC"/>
                    <TextBox x:Name="UrlBox"
                             Height="40"
                             Text="http://127.0.0.1:8096"/>

                    <Button Content="保存服务器"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,22,0,0"
                            Click="Save_Click"/>
                    <Button Content="删除选中服务器"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,10,0,0"
                            Click="Remove_Click"/>
                    <Button Content="返回登录"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,26,0,0"
                            Click="Done_Click"/>
                </StackPanel>
            </controls:LiquidGlassPanel>
        </Grid>
    </Grid>
</UserControl>
