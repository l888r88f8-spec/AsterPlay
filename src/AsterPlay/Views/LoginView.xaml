<UserControl x:Class="AsterPlay.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="520"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="72">
            <StackPanel VerticalAlignment="Center" MaxWidth="620">
                <Border Width="58" Height="58" CornerRadius="16"
                        Background="#0A84FF" HorizontalAlignment="Left">
                    <TextBlock Text="A" Foreground="White" FontSize="30" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="你的媒体，保持安静。"
                           Margin="0,28,0,0"
                           Foreground="White"
                           FontSize="42"
                           FontWeight="SemiBold"/>
                <TextBlock Text="连接 Emby，浏览、播放并同步你的私人媒体库。"
                           Margin="0,14,0,0"
                           Foreground="#8F96A3"
                           FontSize="17"
                           LineHeight="28"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <Border Grid.Column="1"
                Margin="24"
                Padding="34"
                CornerRadius="24"
                Background="#D917181D"
                BorderBrush="#18FFFFFF"
                BorderThickness="1"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="登录" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="选择已保存服务器，或直接输入新的地址。"
                           Margin="0,7,0,26"
                           Foreground="#8F96A3"/>

                <TextBlock Text="服务器" Foreground="#C7CBD3" Margin="0,0,0,7"/>
                <ComboBox x:Name="ServerBox"
                          Height="42"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          DisplayMemberPath="Url"/>

                <Button Content="管理服务器"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Padding="0"
                        Foreground="#6DB6FF"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ManageServers_Click"/>

                <TextBlock Text="用户名" Foreground="#C7CBD3" Margin="0,20,0,7"/>
                <TextBox x:Name="UserBox" Height="42" Padding="12,8"/>

                <TextBlock Text="密码" Foreground="#C7CBD3" Margin="0,16,0,7"/>
                <PasswordBox x:Name="PasswordBox" Height="42" Padding="12,8"/>

                <TextBlock x:Name="MessageBlock"
                           Foreground="#FF8B8B"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"/>

                <Button x:Name="LoginButton"
                        Content="登录"
                        Height="46"
                        Margin="0,22,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Login_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
