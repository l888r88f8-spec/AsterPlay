<UserControl x:Class="AsterPlay.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#08080C">
        <Border Width="470" Padding="38" CornerRadius="22"
                Background="#15151C" BorderBrush="#24FFFFFF" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="AsterPlay" FontSize="36" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Native Windows · WPF + libmpv" Margin="0,4,0,28"
                           Foreground="#98A0AE"/>
                <TextBlock Text="Emby server" Foreground="#D8DCE5" Margin="0,0,0,6"/>
                <TextBox x:Name="ServerBox" Height="42" Padding="12,8"
                         Text="http://127.0.0.1:8096"/>
                <TextBlock Text="Username" Foreground="#D8DCE5" Margin="0,16,0,6"/>
                <TextBox x:Name="UserBox" Height="42" Padding="12,8"/>
                <TextBlock Text="Password" Foreground="#D8DCE5" Margin="0,16,0,6"/>
                <PasswordBox x:Name="PasswordBox" Height="42" Padding="12,8"/>
                <TextBlock x:Name="MessageBlock" Foreground="#FF8B8B"
                           TextWrapping="Wrap" Margin="0,14,0,0"/>
                <Button x:Name="LoginButton" Content="Sign in" Height="48"
                        Margin="0,22,0,0" Click="Login_Click"
                        Background="White" Foreground="#0A0A0F"
                        BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
