<UserControl x:Class="AsterPlay.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AsterPlay.Controls">
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="520"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="72">
            <StackPanel VerticalAlignment="Center" MaxWidth="620">
                <controls:LiquidGlassPanel Width="62"
                                           Height="62"
                                           Padding="0"
                                           CornerRadius="19"
                                           Background="#A92C7EDB"
                                           BloomOpacity="0.56"
                                           GlareOpacity="0.42"
                                           HorizontalAlignment="Left">
                    <TextBlock Text="A"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </controls:LiquidGlassPanel>
                <TextBlock Text="你的媒体，保持安静。"
                           Margin="0,28,0,0"
                           Foreground="White"
                           FontSize="42"
                           FontWeight="SemiBold"/>
                <TextBlock Text="连接 Emby，浏览、播放并同步你的私人媒体库。"
                           Margin="0,14,0,0"
                           Foreground="#8F96A3"
                           FontSize="17"
                           LineHeight="28"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <controls:LiquidGlassPanel Grid.Column="1"
                                           Margin="24"
                                           Padding="34"
                                           CornerRadius="30"
                                           Background="#9418202C"
                                           BorderBrush="{StaticResource LiquidGlassEdgeBrush}"
                                           BloomOpacity="0.40"
                                           GlareOpacity="0.32"
                                           EdgeLightOpacity="0.68"
                                           VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="登录" FontSize="30" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="选择已保存服务器，或直接输入新的地址。"
                           Margin="0,7,0,26"
                           Foreground="#8F96A3"/>

                <TextBlock Text="服务器" Foreground="#C7CBD3" Margin="0,0,0,7"/>
                <ComboBox x:Name="ServerBox"
                          Height="42"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          DisplayMemberPath="Url"/>

                <Button Content="管理服务器"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Padding="0"
                        Foreground="#6DB6FF"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ManageServers_Click"/>

                <TextBlock Text="用户名" Foreground="#C7CBD3" Margin="0,20,0,7"/>
                <TextBox x:Name="UserBox" Height="42" Padding="12,8"/>

                <TextBlock Text="密码" Foreground="#C7CBD3" Margin="0,16,0,7"/>
                <PasswordBox x:Name="PasswordBox" Height="42" Padding="12,8"/>

                <TextBlock x:Name="MessageBlock"
                           Foreground="#FF8B8B"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"/>

                <Button x:Name="LoginButton"
                        Content="登录"
                        Height="46"
                        Margin="0,22,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Login_Click"/>
            </StackPanel>
        </controls:LiquidGlassPanel>
    </Grid>
</UserControl>
