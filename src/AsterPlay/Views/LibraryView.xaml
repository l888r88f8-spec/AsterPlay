<UserControl x:Class="AsterPlay.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AsterPlay.Controls"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="LibraryInput" TargetType="Control">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="#F1F3F7"/>
            <Setter Property="Background" Value="#2AFFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LiquidGlassSoftEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LibraryCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,18,26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="12"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.025"
                                                             Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.025"
                                                             Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.985"
                                                             Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.985"
                                                             Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D2BBDFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:LiquidGlassPanel Grid.Row="0"
                                       Margin="24,18,24,0"
                                       Padding="26,22"
                                       CornerRadius="28"
                                       Background="#82171E2A"
                                       BorderBrush="{StaticResource LiquidGlassEdgeBrush}"
                                       BloomOpacity="0.30"
                                       GlareOpacity="0.24">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="媒体库"
                                   Foreground="White"
                                   FontSize="30"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding ResultLabel}"
                                   Foreground="#98A0AE"
                                   FontSize="13"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Content="刷新"
                            Style="{StaticResource GlassButton}"
                            Padding="16,8"
                            Click="Apply_Click"/>
                </DockPanel>

                <WrapPanel Margin="0,20,0,0">
                    <StackPanel Width="210" Margin="0,0,12,10">
                        <TextBlock Text="媒体库"
                                   Foreground="#9FA6B3"
                                   FontSize="11"
                                   Margin="2,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Libraries}"
                                  SelectedItem="{Binding SelectedLibrary, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource LibraryInput}"/>
                    </StackPanel>

                    <StackPanel Width="150" Margin="0,0,12,10">
                        <TextBlock Text="类型"
                                   Foreground="#9FA6B3"
                                   FontSize="11"
                                   Margin="2,0,0,5"/>
                        <ComboBox ItemsSource="{Binding TypeChoices}"
                                  SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource LibraryInput}"/>
                    </StackPanel>

                    <StackPanel Width="110" Margin="0,0,12,10">
                        <TextBlock Text="年份"
                                   Foreground="#9FA6B3"
                                   FontSize="11"
                                   Margin="2,0,0,5"/>
                        <TextBox Text="{Binding YearText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LibraryInput}"
                                 Padding="9,0"/>
                    </StackPanel>

                    <StackPanel Width="190" Margin="0,0,12,10">
                        <TextBlock Text="排序"
                                   Foreground="#9FA6B3"
                                   FontSize="11"
                                   Margin="2,0,0,5"/>
                        <ComboBox ItemsSource="{Binding SortChoices}"
                                  SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource LibraryInput}"/>
                    </StackPanel>

                    <StackPanel Width="280" Margin="0,0,12,10">
                        <TextBlock Text="搜索"
                                   Foreground="#9FA6B3"
                                   FontSize="11"
                                   Margin="2,0,0,5"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LibraryInput}"
                                 Padding="9,0"
                                 KeyDown="SearchBox_KeyDown"/>
                    </StackPanel>

                    <CheckBox Content="仅收藏"
                              IsChecked="{Binding FavoriteOnly, Mode=TwoWay}"
                              Foreground="#E5E7EC"
                              VerticalAlignment="Bottom"
                              Margin="2,0,16,18"/>

                    <Button Content="应用筛选"
                            Style="{StaticResource GlassButton}"
                            Padding="16,8"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,10"
                            Click="Apply_Click"/>
                </WrapPanel>
            </StackPanel>
        </controls:LiquidGlassPanel>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="32,24,20,132">
                <ItemsControl ItemsSource="{Binding Items}"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="170"
                                    Tag="{Binding}"
                                    Style="{StaticResource LibraryCardButton}"
                                    Click="Item_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="查看详情"
                                                  Click="ItemContextDetails_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Width="170">
                                    <Border Width="170"
                                            Height="250"
                                            CornerRadius="11"
                                            ClipToBounds="True"
                                            Background="#171B24"
                                            BorderBrush="{StaticResource LiquidGlassSoftEdgeBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <controls:CachedImage SourceUrl="{Binding PosterUrl}"
                                                   Stretch="UniformToFill"/>

                                            <Border VerticalAlignment="Top"
                                                    HorizontalAlignment="Left"
                                                    Background="#C40D0D12"
                                                    CornerRadius="0,0,8,0"
                                                    Padding="8,4">
                                                <TextBlock Text="{Binding TypeLabel}"
                                                           Foreground="#E9EBF0"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>

                                            <TextBlock Text="{Binding FavoriteLabel}"
                                                       VerticalAlignment="Top"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,8,8,0"
                                                       Foreground="#FF6B7D"
                                                       FontSize="18"/>

                                            <Border x:Name="HoverInfo"
                                                    VerticalAlignment="Bottom"
                                                    Background="#C6171D27"
                                                    Padding="10,9"
                                                    Opacity="0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="White"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding MetaLine}"
                                                               Foreground="#BDC3CE"
                                                               FontSize="11"
                                                               Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#F4F5F8"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="2,9,2,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding MetaLine}"
                                               Foreground="#9299A6"
                                               FontSize="12"
                                               Margin="2,5,2,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}"
                                             Value="True">
                                    <Setter TargetName="HoverInfo" Property="Opacity" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsKeyboardFocusWithin}"
                                             Value="True">
                                    <Setter TargetName="HoverInfo" Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Background="#D807090D"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                    IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420">
                    <TextBlock Text="这里暂时没有媒体"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="调整媒体库、类型、年份、收藏或搜索条件后再试。"
                               Foreground="#9299A6"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,9,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="LoadingOverlay"
                    Background="#E007090D"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="正在加载媒体库…"
                               Foreground="#D9DDE5"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,18"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <Border Width="120" Height="176" Background="#181820" CornerRadius="10" Margin="5"/>
                        <Border Width="120" Height="176" Background="#1D1D25" CornerRadius="10" Margin="5"/>
                        <Border Width="120" Height="176" Background="#22222B" CornerRadius="10" Margin="5"/>
                        <Border Width="120" Height="176" Background="#1D1D25" CornerRadius="10" Margin="5"/>
                        <Border Width="120" Height="176" Background="#181820" CornerRadius="10" Margin="5"/>
                    </WrapPanel>
                    <ProgressBar IsIndeterminate="True"
                                 Width="260"
                                 Height="3"
                                 Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <controls:LiquidGlassPanel Grid.Row="2"
                                       Margin="24,8,24,96"
                                       Padding="22,12"
                                       CornerRadius="22"
                                       Background="#80171E2A"
                                       BorderBrush="{StaticResource LiquidGlassSoftEdgeBrush}"
                                       BloomOpacity="0.24"
                                       GlareOpacity="0.20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="上一页"
                        HorizontalAlignment="Left"
                        Style="{StaticResource GlassButton}"
                        Padding="15,7"
                        IsEnabled="{Binding CanGoPrevious}"
                        Click="Previous_Click"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding PageLabel}"
                           Foreground="#B8BDC7"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="20,0"/>

                <Button Grid.Column="2"
                        Content="下一页"
                        HorizontalAlignment="Right"
                        Style="{StaticResource GlassButton}"
                        Padding="15,7"
                        IsEnabled="{Binding CanGoNext}"
                        Click="Next_Click"/>
            </Grid>
        </controls:LiquidGlassPanel>
</Grid>
</UserControl>
