<UserControl x:Class="AsterPlay.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="LibraryInput" TargetType="Control">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="#F1F3F7"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LibraryCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,18,26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#08080C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0E0E14"
                BorderBrush="#20FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="32,24,32,20">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="媒体库"
                                   Foreground="White"
                                   FontSize="30"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding ResultLabel}"
                                   Foreground="#98A0AE"
                                   FontSize="13"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Content="刷新"
                            Style="{StaticResource GlassButton}"
                            Padding="16,8"
                            Click="Apply_Click"/>
                </DockPanel>

                <WrapPanel Margin="0,20,0,0">
                    <StackPanel Width="210" Margin="0,0,12,10">
                        <TextBlock Text="媒体库"
                                   Foreground="#9FA6B3"
                                   FontSize="11"
                                   Margin="2,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Libraries}"
                                  SelectedItem="{Binding SelectedLibrary, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource LibraryInput}"/>
                    </StackPanel>

                    <StackPanel Width="150" Margin="0,0,12,10">
                        <TextBlock Text="类型"
                                   Foreground="#9FA6B3"
                                   FontSize="11"
                                   Margin="2,0,0,5"/>
                        <ComboBox ItemsSource="{Binding TypeChoices}"
                                  SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource LibraryInput}"/>
                    </StackPanel>

                    <StackPanel Width="110" Margin="0,0,12,10">
                        <TextBlock Text="年份"
                                   Foreground="#9FA6B3"
                                   FontSize="11"
                                   Margin="2,0,0,5"/>
                        <TextBox Text="{Binding YearText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LibraryInput}"
                                 Padding="9,0"/>
                    </StackPanel>

                    <StackPanel Width="190" Margin="0,0,12,10">
                        <TextBlock Text="排序"
                                   Foreground="#9FA6B3"
                                   FontSize="11"
                                   Margin="2,0,0,5"/>
                        <ComboBox ItemsSource="{Binding SortChoices}"
                                  SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource LibraryInput}"/>
                    </StackPanel>

                    <StackPanel Width="280" Margin="0,0,12,10">
                        <TextBlock Text="搜索"
                                   Foreground="#9FA6B3"
                                   FontSize="11"
                                   Margin="2,0,0,5"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LibraryInput}"
                                 Padding="9,0"
                                 KeyDown="SearchBox_KeyDown"/>
                    </StackPanel>

                    <CheckBox Content="仅收藏"
                              IsChecked="{Binding FavoriteOnly, Mode=TwoWay}"
                              Foreground="#E5E7EC"
                              VerticalAlignment="Bottom"
                              Margin="2,0,16,18"/>

                    <Button Content="应用筛选"
                            Style="{StaticResource GlassButton}"
                            Padding="16,8"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,10"
                            Click="Apply_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="32,24,20,24">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="170"
                                    Tag="{Binding}"
                                    Style="{StaticResource LibraryCardButton}"
                                    Click="Item_Click">
                                <StackPanel Width="170">
                                    <Border Width="170"
                                            Height="250"
                                            CornerRadius="11"
                                            ClipToBounds="True"
                                            Background="#17171E"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1">
                                        <Grid>
                                            <Image Source="{Binding PosterUrl}"
                                                   Stretch="UniformToFill"/>

                                            <Border VerticalAlignment="Top"
                                                    HorizontalAlignment="Left"
                                                    Background="#C40D0D12"
                                                    CornerRadius="0,0,8,0"
                                                    Padding="8,4">
                                                <TextBlock Text="{Binding TypeLabel}"
                                                           Foreground="#E9EBF0"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>

                                            <TextBlock Text="{Binding FavoriteLabel}"
                                                       VerticalAlignment="Top"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,8,8,0"
                                                       Foreground="#FF6B7D"
                                                       FontSize="18"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#F4F5F8"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="2,9,2,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding MetaLine}"
                                               Foreground="#9299A6"
                                               FontSize="12"
                                               Margin="2,5,2,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border x:Name="LoadingOverlay"
                    Background="#9908080C"
                    Visibility="{Binding IsLoading, Converter={x:Static BooleanToVisibilityConverter.Instance}}">
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#0E0E14"
                BorderBrush="#20FFFFFF"
                BorderThickness="0,1,0,0"
                Padding="32,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="上一页"
                        HorizontalAlignment="Left"
                        Style="{StaticResource GlassButton}"
                        Padding="15,7"
                        IsEnabled="{Binding CanGoPrevious}"
                        Click="Previous_Click"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding PageLabel}"
                           Foreground="#B8BDC7"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="20,0"/>

                <Button Grid.Column="2"
                        Content="下一页"
                        HorizontalAlignment="Right"
                        Style="{StaticResource GlassButton}"
                        Padding="15,7"
                        IsEnabled="{Binding CanGoNext}"
                        Click="Next_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
