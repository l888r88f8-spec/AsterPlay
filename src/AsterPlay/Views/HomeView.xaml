<UserControl x:Class="AsterPlay.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AsterPlay.Controls"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <Style x:Key="HeroAction" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="46"/>
        </Style>
        <Style x:Key="MediaCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryTab" TargetType="Button">
            <Setter Property="Foreground" Value="#CCD1DB"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CC3EA6FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#003EA6FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#08080C">
        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
            <StackPanel>
                <Grid x:Name="HeroRoot" Height="620" ClipToBounds="True">
                    <controls:CachedImage SourceUrl="{Binding CurrentHero.BackdropUrl}"
                           Stretch="UniformToFill"/>

                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#E808080C" Offset="0"/>
                                <GradientStop Color="#A008080C" Offset="0.32"/>
                                <GradientStop Color="#1808080C" Offset="0.68"/>
                                <GradientStop Color="#0008080C" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Rectangle VerticalAlignment="Bottom" Height="260">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#0008080C" Offset="0"/>
                                <GradientStop Color="#B008080C" Offset="0.65"/>
                                <GradientStop Color="#FF08080C" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Grid x:Name="HeroLayout" Margin="48,28,48,42">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <ItemsControl ItemsSource="{Binding Libraries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource LibraryTab}"
                                                Tag="{Binding}" Click="LibraryTab_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Items.Count, StringFormat={}{0}}" Margin="8,0,0,0"
                                                           Opacity="0.7"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button DockPanel.Dock="Right" Margin="22,0,0,0"
                                    Style="{StaticResource GlassButton}"
                                    Content="Sign out" Click="Logout_Click"/>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="HeroThumbColumn" Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="HeroInfoPanel"
                                        VerticalAlignment="Bottom"
                                        MaxWidth="620"
                                        HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding CurrentLibrary.Name}"
                                           Foreground="#6DB9FF" FontSize="13"
                                           FontWeight="Bold"
                                           Margin="0,0,0,12"/>
                                <TextBlock x:Name="HeroTitle"
                                           Text="{Binding CurrentHero.Title}"
                                           Foreground="White" FontSize="48"
                                           FontWeight="Bold" TextWrapping="Wrap"
                                           LineHeight="56"/>
                                <TextBlock Text="{Binding CurrentHero.MetaLine}"
                                           Foreground="#EEF0F5" FontSize="14"
                                           FontWeight="SemiBold" Margin="0,16,0,0"/>
                                <TextBlock x:Name="HeroOverview"
                                           Text="{Binding CurrentHero.Overview}"
                                           Foreground="#D7DBE4" FontSize="15"
                                           LineHeight="26" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="82" Margin="0,14,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                    <Button Style="{StaticResource HeroAction}"
                                            Background="White" Foreground="#0A0A0F"
                                            Content="▶  Play" Click="Play_Click"/>
                                    <Button Style="{StaticResource HeroAction}"
                                            Content="{Binding CurrentHero.FavoriteLabel}"
                                            Click="Favorite_Click"/>
                                    <Button Style="{StaticResource HeroAction}"
                                            Content="ⓘ  Details" Click="Details_Click"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding CurrentLibrary.Items}"
                                              Margin="0,26,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="4" Margin="0,0,8,0" CornerRadius="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Width" Value="22"/>
                                                        <Setter Property="Background" Value="#55FFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Width" Value="36"/>
                                                                <Setter Property="Background" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <ScrollViewer x:Name="HeroThumbScroller"
                                          Grid.Column="1"
                                          MaxWidth="500"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Bottom">
                                <ItemsControl x:Name="HeroThumbRail"
                                              ItemsSource="{Binding CurrentLibrary.Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}" Click="HeroThumb_Click"
                                                    Padding="0" Margin="8,0,0,0"
                                                    Background="Transparent"
                                                    BorderThickness="0" Cursor="Hand">
                                                <Border CornerRadius="8" BorderThickness="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Setter Property="Opacity" Value="0.52"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#3EA6FF"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <controls:CachedImage SourceUrl="{Binding BackdropUrl}"
                                                           Width="92" Height="52"
                                                           Stretch="UniformToFill"/>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <StackPanel Margin="42,6,42,60">
                    <TextBlock Text="继续观看" Foreground="White"
                               FontSize="23" FontWeight="SemiBold" Margin="0,18,0,14"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ResumeItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="260" Margin="0,0,16,0"
                                            Style="{StaticResource MediaCardButton}"
                                            Tag="{Binding}" Click="ResumeCard_Click">
                                        <StackPanel>
                                            <Border Height="146" CornerRadius="10"
                                                    Background="#15151C" ClipToBounds="True">
                                                <Grid>
                                                    <controls:CachedImage SourceUrl="{Binding BackdropUrl}"
                                                           Stretch="UniformToFill"/>
                                                    <ProgressBar Value="{Binding PlayedPercentage, Mode=OneWay}"
                                                                 Maximum="100" Height="4"
                                                                 VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding ResumeTitle}" Foreground="#F5F6F8"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Margin="3,8,3,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="最新媒体" Foreground="White"
                               FontSize="23" FontWeight="SemiBold" Margin="0,30,0,14"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding LatestItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="168" Margin="0,0,16,0"
                                            Style="{StaticResource MediaCardButton}"
                                            Tag="{Binding}" Click="LatestCard_Click">
                                        <StackPanel>
                                            <Border Height="245" CornerRadius="10"
                                                    Background="#15151C" ClipToBounds="True">
                                                <controls:CachedImage SourceUrl="{Binding PosterUrl}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="#F5F6F8"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Margin="3,8,3,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="LoadingOverlay" Background="#E608080C"
                Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="AsterPlay" Foreground="White"
                           FontSize="38" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Loading your library…" Foreground="#9299A6"
                           Margin="0,10,0,0"/>
                <ProgressBar IsIndeterminate="True" Width="220" Height="3"
                             Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
