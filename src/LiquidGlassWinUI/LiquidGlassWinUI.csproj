<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>LiquidGlassWinUI</RootNamespace>
    <AssemblyName>LiquidGlassWinUI</AssemblyName>
    <OutputType>Library</OutputType>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Effects\Shaders\LiquidGlass.hlsl" />
    <EmbeddedResource Include="Effects\Shaders\BlurH.hlsl" />
    <EmbeddedResource Include="Effects\Shaders\BlurV.hlsl" />
    <EmbeddedResource Include="Effects\Shaders\PostProcessing.hlsl" />
    <EmbeddedResource Include="Effects\Shaders\Shimmer.hlsl" />
  </ItemGroup>
</Project>
